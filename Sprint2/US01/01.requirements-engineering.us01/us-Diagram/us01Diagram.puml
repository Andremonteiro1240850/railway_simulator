@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":System" as System

activate Editor

    Editor -> System : Request to create a map
        activate System

    System -> Editor : Verify permission
    deactivate System

    Editor -> System : Provide map details (Size, name)
        activate System

    System --> Editor : Show map information
        deactivate System

    Editor -> System : Confirm map creation
        activate System

    System --> Editor : Display operation success and save map
        deactivate System

@enduml
