@startuml

skinparam classAttributeIconSize 0

class EditorSession
{
    - EditorSession()
    + {static} getInstance()
    + getCurrentSession()
}

class UserSession
{
    + getUserEmail()
}

class Editor {
    - name : String
    - email : String
}

class Map {
    - name : String
    - size : int

    + Map(name, size, createdBy)
}

class MapRepository {
    + getMaps()
    + getMapByName(name)
}

class EditorRepository {
    + getEditorByEmail(email)
}

class Repositories {
    - Repositories()
    + {static} getInstance()
    + getMapRepository()
    + getEditorRepository()
}

class CreateMapController {
    + CreateMapController()
    + createMap(name, size)
    - getEditorFromSession()
}

note right of CreateMapController
    Editor is retrieved from session
end note

class CreateMapUI {
}

CreateMapUI .> CreateMapController

CreateMapController ..> EditorSession
CreateMapController ..> UserSession
CreateMapController ..> MapRepository
CreateMapController ..> EditorRepository
CreateMapController .> Repositories

Repositories -> "1" Repositories : instance
Repositories --> "1" EditorRepository : editorRepository
Repositories -> "1" MapRepository : mapRepository

EditorSession -> "1" EditorSession : instance
EditorSession ..> UserSession

MapRepository --> "*" Map : maps
EditorRepository --> "*" Editor : editors

Map --> "1" Editor : createdBy

@enduml
