@startuml
'https://plantuml.com/sequence-diagram
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber
'hide footbox

alt sucesso
    CreateMapController -> CreateMapUI : onSuccess("Map created successfully")
    deactivate CreateMapController

    CreateMapUI --> CreateMapUI : showSuccessMessage()
    deactivate CreateMapUI
else erro
    CreateMapController -> CreateMapUI : onError("Invalid input")
    deactivate CreateMapController

    CreateMapUI --> CreateMapUI : showErrorMessage()
    deactivate CreateMapUI
end
@enduml