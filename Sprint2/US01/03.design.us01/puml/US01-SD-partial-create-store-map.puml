@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
autonumber
hide footbox

actor User as "Editor (User)"
participant ":AuthUI" as AuthUI
participant ":AuthController" as AuthCtrl
participant ":UserSession" as Session
participant ":PasswordValidator" as Validator




activate AuthCtrl

AuthCtrl -> Session : getCurrentUser()
activate Session
Session --> AuthCtrl : user()
deactivate Session

alt "Session valid"
  AuthCtrl -> Validator : validatePermissions(user)
  activate Validator
  Validator --> AuthCtrl : hasAccess(true)
  deactivate Validator



end

deactivate AuthCtrl
@enduml