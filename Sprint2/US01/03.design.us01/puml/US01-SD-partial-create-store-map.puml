@startuml
'https://plantuml.com/sequence-diagram
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber
'hide footbox

CreateMapController -> Organization : createMap(name, width, height)
activate Organization
Organization -> Map : new(name, width, height)
deactivate Organization
activate Map
Map --> Organization
deactivate Map
activate Organization
Organization --> CreateMapController : Map
deactivate Organization
activate CreateMapController

CreateMapController -> OrganizationRepository : save(Map)
deactivate CreateMapController
activate OrganizationRepository
OrganizationRepository --> CreateMapController : success status
deactivate OrganizationRepository
activate CreateMapController
@enduml