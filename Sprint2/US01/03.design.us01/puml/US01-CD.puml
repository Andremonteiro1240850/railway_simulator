@startuml
'https://plantuml.com/class-diagram

'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class CreateMapUI {
  - controller: CreateMapController
  + startCreateMap()
  + showSuccessOrError()
}

class CreateMapController {
  - userSession: UserSession
  - orgRepo: OrganizationRepository
  + validateName()
  + validateDimensions()
  + createMap(name, width, height)
}

class UserSession {
  - userId: String
  + getUser(): User
}

class Organization {
  + createMap(name, width, height): Map
}

class Map {
  - name: String
  - width: int
  - height: int
  + getName()
  + getDimensions()
}

class OrganizationRepository {
  + save(map: Map)
}

CreateMapUI --> CreateMapController
CreateMapController --> UserSession
CreateMapController --> Organization
Organization --> Map
CreateMapController --> OrganizationRepository
@enduml
