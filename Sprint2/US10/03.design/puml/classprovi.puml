@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline

class AssignRouteUI <<C>> {
    +requestAssignTrain()
    +displayAvailableTrains()
    +confirmRouteAssignment()
    +displaySuccess()
}

class AssignRouteController <<C>> {
    +listAvailableTrains() : List<Train>
    +assignRoute(trainId: String, stations: List<Station>, cargoMap: Map<Station, List<Cargo>>) : void
    +getCurrentPlayer() : Player
    +checkConnectivity(route: Route) : boolean
}

class Repositories <<C>> {
    +getInstance() : Repositories
    +getTrainRepository() : TrainRepository
    +getStationRepository() : StationRepository
    +getRouteRepository() : RouteRepository
    +getPlayerRepository() : PlayerRepository
}

class ApplicationSession <<C>> {
    +getInstance() : ApplicationSession
    +getCurrentSession() : UserSession
}

class UserSession {
    +getUserEmail() : String
}

class PlayerRepository {
    +findByEmail(email: String) : Player
}

class TrainRepository {
    +findAvailable() : List<Train>
    +findById(id: String) : Train
}

class StationRepository {
    +findAll() : List<Station>
    +checkConnectivity(stations: List<Station>) : boolean
}

class RouteRepository {
    +exists(route: Route) : boolean
    +save(route: Route) : void
}

class Player {
    -name: String
    -email: String
    -trains: List<Train>
    +getTrains() : List<Train>
    +assignRoute(route: Route, cargoMap: Map<Station, List<Cargo>>) : void
}

class Train {
    -id: String
    -model: String
    -locomotive: Locomotive
    -cargoItems: List<Cargo>
    +assignToRoute(route: Route) : void
}

class Route {
    -stations: List<Station>
    +isValid() : boolean
}

class Locomotive {
    -id: String
    -type: String
    -availableFrom: LocalDate
    -availableUntil: LocalDate
    +isAvailableOn(date: LocalDate) : boolean
}

class Cargo {
    -description: String
    -weight: double
    -destination: Station
}

class Station {
    -name: String
}

' === Method-Based Relationships ===
AssignRouteUI --> AssignRouteController : requestAssignTrain()
AssignRouteUI --> AssignRouteController : displayAvailableTrains()
AssignRouteUI --> AssignRouteController : confirmRouteAssignment()
AssignRouteUI --> AssignRouteController : displaySuccess()

AssignRouteController --> ApplicationSession : getInstance()
ApplicationSession --> UserSession : getCurrentSession()
UserSession --> AssignRouteController : getUserEmail()

AssignRouteController --> Repositories : getInstance()
Repositories --> PlayerRepository : getPlayerRepository()
Repositories --> TrainRepository : getTrainRepository()
Repositories --> StationRepository : getStationRepository()
Repositories --> RouteRepository : getRouteRepository()

AssignRouteController --> PlayerRepository : findByEmail(email)
AssignRouteController --> TrainRepository : findAvailable()
AssignRouteController --> TrainRepository : findById(id)
AssignRouteController --> StationRepository : checkConnectivity(stations)
AssignRouteController --> Route : isValid()
AssignRouteController --> Player : assignRoute(...)
Player --> Train : assignToRoute(...)
AssignRouteController --> RouteRepository : save(route)

Player --> Train : getTrains()
Train --> Locomotive : locomotive
Train --> Route : assignToRoute(...)
Route --> Station : stations
Player --> Route : assignRoute(...)
Route --> Cargo : deliveredTo
Cargo --> Station : destination
@enduml
