@startuml
actor Player
participant ":System"

autonumber

Player -> ":System" :  Requests to assign a train to a route
":System" -> Player :  Lists available trains and asks to select one
Player -> ":System" :  Selects a train

loop
    ":System" -> Player : Lists possible stations and requests selection
    Player -> ":System" : Selects one station
    ":System" -> Player : Lists possible cargo types to pick up at station
    Player -> ":System" : Selects cargo to pick up
end

":System" -> Player : Displays route and cargo summary, requests confirmation
Player -> ":System" : Confirms data
":System" -> Player : Displays operation success
@enduml

