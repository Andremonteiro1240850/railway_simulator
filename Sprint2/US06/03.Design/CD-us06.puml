@startuml
skinparam monochrome false
skinparam packageStyle rectangle
skinparam shadowing false

class Player {
}

class UpgradeStationUI {
  + askToUpgradeStation()
  + showAvailableStations()
  + requestBuildingType()
  + showUpgradeSummary()
  + displayUpgradeResult()
}

class UpgradeStationController {
  + initialize()
  + getStations()
  + selectUpgradeBuilding()
  + executeUpgrade()
}

class Organization {
  + applyStationUpgrade()
}

class PlayerRepository {
  + getCurrentPlayer()
}

class StationRepository {
  + getStationsByPlayer()
}

class BuildingRepository {
  + getBuildingsByType()
}

class StationValidator {
  + getAvailableBuildings()
}

class EconomyManager {
  + verifyIfPossible()
}

class StationUpgrader {
  + applyUpgrade()
}

' Relacionamentos
Player --> UpgradeStationUI : usa
UpgradeStationUI --> UpgradeStationController : comunica com

UpgradeStationController --> PlayerRepository : consulta
UpgradeStationController --> StationRepository : consulta
UpgradeStationController --> BuildingRepository : consulta
UpgradeStationController --> StationValidator : valida
UpgradeStationController --> EconomyManager : verifica fundos
UpgradeStationController --> StationUpgrader : executa upgrade
UpgradeStationController --> Organization : registra upgrade

Organization --> PlayerRepository : gerencia
Organization --> StationRepository : possui
Organization --> BuildingRepository : mantém
Organization --> EconomyManager : controla
Organization --> StationUpgrader : coordena

StationValidator --> BuildingRepository : filtra
StationUpgrader --> StationValidator : valida pré-requisitos

note right of UpgradeStationController::executeUpgrade
  Fluxo principal:
  1. Verifica fundos
  2. Aplica upgrade
  3. Registra na organização
  4. Retorna status
end note

note bottom of StationValidator
  Responsável por:
  - Validar edifícios compatíveis
  - Verificar pré-requisitos
  - Controlar upgrades permitidos
end note

note left of EconomyManager
  Gerencia:
  - Recursos do jogador
  - Custo de upgrades
  - Transações econômicas
end note
@enduml