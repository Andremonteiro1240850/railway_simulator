@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Employee
participant ":System" as System

activate Employee

    Employee -> System : Ask to create a scenario
        activate System

    System -> Employee : Verify permission
    deactivate System

    Employee -> System : Select a map
        activate System

    System --> Employee :  Request scenario details
        deactivate System

    Employee -> System : Provide scenario details
        activate System

    System --> Employee : Shows all the information given
        deactivate System

    Employee -> System : Confirms information
        activate System

    System --> Employee : Displays operation success
        deactivate System
@enduml

