@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":CreateScenarioController" as CTRL
participant "scenario\n:ScenarioManager" as SCEN

autonumber 1
-> CTRL: createScenario(map, params)
activate CTRL

    CTRL --> SCEN**: create(map, params)
    activate SCEN
        SCEN -> SCEN: setPortBehavior()
        SCEN -> SCEN: setLocomotionTypes()
        SCEN -> SCEN: configureIndustries()
        SCEN --> CTRL: newScenario
    deactivate SCEN
<-- CTRL: scenarioCreated
deactivate CTRL
@enduml