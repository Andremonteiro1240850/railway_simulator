@startuml
skinparam monochrome false
skinparam packageStyle rectangle
skinparam shadowing false

class Editor {
}

class CreateScenarioUI {
  + askToCreateNewScenario()
  + showAvailableMaps(mapsList)
  + requestScenarioDetails()
  + showConfirmation(data)
  + displaySuccess()
}

class CreateScenarioController {
  + getAvailableMaps()
  + getAvailablePortBehaviors()
  + getAvailableLocomotionTypes()
  + getIndustryGenerationFactors()
  + createScenario(params)
}

class Organization {
}

class MapRepository {
  + getAllMaps()
}

class PortRepository {
  + getBehaviorOptions()
}

class TransportSystem {
  + requestLocomotionTypes()
}

class IndustryRepository {
  + getGenerationFrequency()
}

class ScenarioManager {
  + create(map, params)
  + setPortBehavior()
  + setLocomotionTypes()
  + configureIndustries()
}

' Relacionamentos
Editor --> CreateScenarioUI : usa
CreateScenarioUI --> CreateScenarioController : comunica com
CreateScenarioController --> MapRepository : consulta
CreateScenarioController --> PortRepository : consulta
CreateScenarioController --> TransportSystem : consulta
CreateScenarioController --> IndustryRepository : consulta
CreateScenarioController --> ScenarioManager : cria/gerencia
CreateScenarioController --> Organization : verifica permissões
ScenarioManager --> PortManager : configura
ScenarioManager --> TransportSystem : configura
ScenarioManager --> IndustryManager : configura
Organization --> MapManager : possui
Organization --> PortManager : possui
Organization --> TransportSystem : possui
Organization --> IndustryManager : possui
Organization --> ScenarioManager : possui

note right of CreateScenarioController::createScenario
  1. Cria novo cenário
  2. Configura comportamentos
  3. Retorna cenário criado
end note

note bottom of ScenarioManager
  Responsável por:
  - Gerenciar configurações do cenário
  - Persistir parâmetros
  - Coordenar subsistemas
end note
@enduml