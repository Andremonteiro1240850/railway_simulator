@startuml
skinparam classAttributeIconSize 0
skinparam classFontStyle plain
skinparam shadowing false
skinparam linetype ortho

hide circle

class Player  {
  +name
  +email
}

class Scenario {
  +name
  +currentDate
}

class Locomotive {
  +id
  +type
  +price
  +availableFrom
  +availableUntil
}

class Purchase {
  +timestamp
  +status
  +price
}





Player "1" --> "1" Scenario : plays in
Scenario "1" --> "*" Locomotive : provides




Player --> Purchase : makes
Purchase --> Locomotive : involves


@enduml
