@startuml
' US09 - Full Sequence Diagram
skinparam shadowing false
skinparam linetype polyline
skinparam monochrome true

autonumber

actor Player

participant Player
participant BuyLocomotiveUI
participant BuyLocomotiveController
participant ApplicationSession
participant UserSession
participant Repositories
participant PlayerRepository
participant LocomotiveRepository
participant Locomotive
participant Purchase

activate Player

    Player -> BuyLocomotiveUI : requests to buy a locomotive in the current scenario
    activate BuyLocomotiveUI


      Player <-- BuyLocomotiveUI   : displays list of avaible locomotives(filtred by scenario)
    deactivate BuyLocomotiveUI

    Player -> BuyLocomotiveUI : selects a locomotive(shop)
   activate BuyLocomotiveUI

      Player <-- BuyLocomotiveUI : shows information about locomotive (i.e. type, price, current date)
    deactivate BuyLocomotiveUI

    Player -> BuyLocomotiveUI : confirms purchsase
    activate BuyLocomotiveUI

        Player <-- BuyLocomotiveUI: generate unique id for locomotive
    deactivate BuyLocomotiveUI




        Player -> BuyLocomotiveUI: confirms purchase and displays succes message
    deactivate BuyLocomotiveUI
@enduml