@startuml

skinparam shadowing false
skinparam linetype polyline
skinparam monochrome true

autonumber

actor Player

participant Player
activate Player
participant BuyLocomotiveUI
participant BuyLocomotiveController
participant ScenarioRepository
participant LocomotiveRepository
participant Locomotive
participant PlayerSessionRepository
participant PlayerSession
participant Scenario
participant LocomotivePurchase

Player -> BuyLocomotiveUI : request to buy a locomotive
activate BuyLocomotiveUI
BuyLocomotiveUI -> BuyLocomotiveController : getAvailableLocomotives()
activate BuyLocomotiveController
BuyLocomotiveController -> ScenarioRepository : getScenario()
activate ScenarioRepository
ScenarioRepository --> BuyLocomotiveController : Scenario
deactivate ScenarioRepository
BuyLocomotiveController -> LocomotiveRepository : getCurrentScenarioLocomotives()
activate LocomotiveRepository
LocomotiveRepository --> BuyLocomotiveController : CurrentScenarioLocomotives
deactivate LocomotiveRepository
BuyLocomotiveController --> BuyLocomotiveUI : AvailableLocomotives
deactivate BuyLocomotiveController
BuyLocomotiveUI --> Player : Displays list of available locomotives (filtered by scenario)
deactivate BuyLocomotiveUI

Player -> BuyLocomotiveUI : selects a locomotive
activate BuyLocomotiveUI
BuyLocomotiveUI -> BuyLocomotiveController : getLocomotiveDetails()
activate BuyLocomotiveController
BuyLocomotiveController -> LocomotiveRepository : getLocomotive()
activate LocomotiveRepository
LocomotiveRepository --> BuyLocomotiveController : Locomotive
deactivate LocomotiveRepository
BuyLocomotiveController -> Locomotive : getType()
activate Locomotive
BuyLocomotiveController <-- Locomotive : type
deactivate Locomotive
BuyLocomotiveController -> Locomotive : getPrice()
activate Locomotive
BuyLocomotiveController <-- Locomotive : price
deactivate Locomotive
BuyLocomotiveController --> BuyLocomotiveUI : LocomotiveDetails
deactivate BuyLocomotiveController
BuyLocomotiveUI --> Player : displayLocomotiveDetails
deactivate BuyLocomotiveUI

Player -> BuyLocomotiveUI : confirmPurchase
activate BuyLocomotiveUI
BuyLocomotiveUI -> BuyLocomotiveController : confirmPurchase (locomotive)
activate BuyLocomotiveController
BuyLocomotiveController -> PlayerSessionRepository : getSessionByPlayerId(playerId)
activate PlayerSessionRepository
PlayerSessionRepository --> BuyLocomotiveController : PlayerSession
deactivate PlayerSessionRepository
activate PlayerSession


deactivate LocomotiveRepository
BuyLocomotiveController -> Locomotive : getPrice()
activate Locomotive
Locomotive --> BuyLocomotiveController : price
deactivate Locomotive
BuyLocomotiveController -> PlayerSession : canAfford(price)
BuyLocomotiveController -> PlayerSession : deductBudget(price)
deactivate PlayerSession
BuyLocomotiveController -> ScenarioRepository : getScenario()
activate ScenarioRepository
ScenarioRepository --> BuyLocomotiveController : Scenario
deactivate ScenarioRepository
activate Scenario
BuyLocomotiveController -> Scenario : getCurrentDate()
Scenario --> BuyLocomotiveController : currentDate
deactivate Scenario
activate LocomotivePurchase
BuyLocomotiveController -> LocomotivePurchase : create(purchaseId, baseId, type, price, date)
deactivate LocomotivePurchase
activate PlayerSession
BuyLocomotiveController -> PlayerSession : addPurchase(LocomotivePurchase)
deactivate PlayerSession
BuyLocomotiveController --> BuyLocomotiveUI : return success message
deactivate BuyLocomotiveController
BuyLocomotiveUI --> Player : confirms purchase and displays succes message
deactivate BuyLocomotiveUI
deactivate Player

@enduml
