@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":System" as System

activate Editor

    Editor -> System : Start to add industry
    activate System

    System -> Editor : Request map selection
    deactivate System

    Editor -> System : Select current map
    activate System

    System -> Editor : Request position and industry type
    deactivate System

    Editor -> System : Provide position (x,y) and industry type
    activate System

    alt Valid type and position
        System -> System : Create industry
        System -> System : Add to map
        System --> Editor : Show industry added successfully
    else Invalid type
        System --> Editor : Display "Invalid industry type" error
    else Invalid position
        System --> Editor : Display "Invalid position" error
    end
    deactivate System

deactivate Editor
@enduml