@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":System" as System

activate Editor

    Editor -> System : Request to add an industry
        activate System

    System -> Editor : Verify permission
    deactivate System

    Editor -> System : Select a position XY on the map
        activate System

    System --> Editor : Request industry type
        deactivate System

    Editor -> System : Provide industry type
        activate System

    System --> Editor : Show industry information
        deactivate System

    Editor -> System : Confirm industry creation
        activate System

    System --> Editor : Display operation success
        deactivate System

@enduml

