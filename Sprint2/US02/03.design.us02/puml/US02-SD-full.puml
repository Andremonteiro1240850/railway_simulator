@startuml
'https://plantuml.com/sequence-diagram
skinparam packageStyle rectangle
skinparam shadowing false

autonumber
hide footbox

actor Editor

participant "AddIndustryUI" as UI
participant "AddIndustryController" as Controller
participant "UserService" as UserService
participant "MapRepository" as MapRepo
participant "IndustryTypeRepository" as IndustryRepo
participant "Map" as Map
participant "Industry" as Industry

activate Editor
Editor -> UI : Start to Add Industry
activate UI

UI -> Controller : requestAddIndustry()
deactivate UI
activate Controller

Controller -> UserService : verifyEditorPermission(Editor)
activate UserService
UserService --> Controller : permissionGranted
deactivate UserService

Controller --> UI : requestMapSelection()
deactivate Controller
activate UI
UI --> Editor : Display available maps
deactivate UI

Editor -> UI : Select current map
activate UI
UI -> Controller : provideMapSelection(mapId)
deactivate UI
activate Controller

Controller -> MapRepo : getMapById(mapId)
activate MapRepo
MapRepo --> Controller : Map
deactivate MapRepo

Controller --> UI : requestPositionAndType()
deactivate Controller
activate UI
UI --> Editor : Ask for Position and Industry Type
deactivate UI

Editor -> UI : Provide Position (x,y) and Industry Type
activate UI
UI -> Controller : provideIndustryDetails(x, y, type)
deactivate UI
activate Controller

Controller -> IndustryRepo : isValidIndustryType(type)
activate IndustryRepo
IndustryRepo --> Controller : boolean
deactivate IndustryRepo

alt Type is valid
    Controller -> Map : isPositionValid(x, y)
    activate Map
    Map --> Controller : boolean
    deactivate Map

    alt Position is valid
        Controller -> Industry : create(type, x, y)
        activate Industry
        Industry --> Controller : newIndustry
        deactivate Industry

        Controller -> Map : addIndustry(newIndustry)
        activate Map
        Map --> Controller : success
        deactivate Map

        Controller -> MapRepo : saveMap(Map)
        activate MapRepo
        MapRepo --> Controller : confirmation
        deactivate MapRepo

        Controller --> UI : showSuccess(newIndustry)
        deactivate Controller
        activate UI
        UI --> Editor : Display industry added successfully
        deactivate UI
    else Position is invalid
        Controller --> UI : showError("Invalid position")
        deactivate Controller
        activate UI
        UI --> Editor : Display error message
        deactivate UI
    end
else Type is invalid
    Controller --> UI : showError("Invalid industry type")
    deactivate Controller
    activate UI
    UI --> Editor : Display error message
    deactivate UI
end

deactivate Editor
@enduml