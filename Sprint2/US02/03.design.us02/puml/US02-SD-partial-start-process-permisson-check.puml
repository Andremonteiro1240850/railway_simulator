@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

'hide footbox
actor Editor

participant AddIndustryUI
participant AddIndustryController
participant UserService

Editor -> AddIndustryUI : startAddIndustry()
AddIndustryUI -> AddIndustryController : startAddProcess()

AddIndustryController -> UserService : verifyPermission()
UserService --> AddIndustryController : permissionGranted
@enduml


