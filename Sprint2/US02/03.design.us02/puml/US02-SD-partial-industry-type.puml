@startuml
skinparam packageStyle rectangle
skinparam shadowing false
autonumber
hide footbox

actor Editor
participant "AddIndustryUI" as UI
participant "AddIndustryController" as Controller
participant "IndustryTypeRepository" as IndustryRepo

activate Editor
UI --> Editor : Request Industry Type
Editor -> UI : Provide Industry Type
activate UI
UI -> Controller : provideIndustryDetails(type)
deactivate UI
activate Controller

Controller -> IndustryRepo : isValidIndustryType(type)
activate IndustryRepo
IndustryRepo --> Controller : boolean
deactivate IndustryRepo

alt Type is valid
    Controller --> UI : showSuccess()
    deactivate Controller
    activate UI
    UI --> Editor : Display type of the Industry
    deactivate UI
else Type is invalid
    Controller --> UI : showError("Invalid industry type")
    deactivate Controller
    activate UI
    UI --> Editor : Display error message
    deactivate UI
end
deactivate Editor
@enduml