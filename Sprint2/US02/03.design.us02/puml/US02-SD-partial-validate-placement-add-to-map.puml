@startuml
'https://plantuml.com/sequence-diagram
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

'hide footbox

AddIndustryController -> Industry : validatePlacement()
deactivate Industry

AddIndustryController -> Map : addIndustry(industry)
activate Map
Map --> AddIndustryController : success
deactivate Map
@enduml
