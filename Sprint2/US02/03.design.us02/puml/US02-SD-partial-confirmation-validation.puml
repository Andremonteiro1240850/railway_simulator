@startuml
'https://plantuml.com/sequence-diagram
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

'hide footbox

actor Editor
participant AddIndustryUI
participant AddIndustryController
participant Map
participant MapRepository
activate Editor

Editor -> AddIndustryUI : Confirm Creation
activate AddIndustryUI
AddIndustryUI -> AddIndustryController : confirmCreation()
deactivate AddIndustryUI
activate AddIndustryController

AddIndustryController -> Map : validatePlacement()
activate Map
Map --> AddIndustryController : Placement Validated
deactivate Map
AddIndustryController -> Map : addIndustry(industry)
activate Map

Map --> AddIndustryController : Add Industry
deactivate Map


AddIndustryController -> MapRepository : save map (industry location)
activate MapRepository
MapRepository --> AddIndustryController : Confirmation
deactivate MapRepository

AddIndustryController -> AddIndustryUI : success/failure
deactivate AddIndustryController
AddIndustryUI -> Editor : Display Operation Success
deactivate Editor
@enduml

