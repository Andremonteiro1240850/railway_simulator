@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":CreateStationController" as CTRL
participant "geometry\n:StationGeometry" as GEO
participant "validation\n:PositionValidator" as VALID

autonumber 6.5
-> CTRL : getCentre()
activate CTRL

        CTRL -> GEO : calculateCenter(stationType, location)
        activate GEO
            GEO --> CTRL : centerPoint
        deactivate GEO

        CTRL -> VALID : validateCenter(centerPoint)
        activate VALID
            VALID --> CTRL : isValid
        deactivate VALID

    autonumber 6.6
    <-- CTRL : centerPoint
deactivate CTRL
@enduml