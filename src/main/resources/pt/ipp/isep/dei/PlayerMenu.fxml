<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8" fx:controller="pt.ipp.isep.dei.ui.gui.PlayerController">
   <children>
   
      <!-- Map View -->
      <Pane fx:id="mapView" layoutY="50" prefHeight="600" prefWidth="800">
      <children>
            <ImageView fx:id="mapImage" fitHeight="600" fitWidth="800" />
         
            <!-- Train List -->
            <TableView fx:id="trainList" layoutX="385.0" layoutY="94.0" prefHeight="400.0" prefWidth="415.0">
               <columns>
                  <TableColumn fx:id="trainNameColumn" text="Train Name" />
                  <TableColumn fx:id="locomotiveColumn" text="Locomotive Type" />
                  <TableColumn fx:id="cargoColumn" text="Current Cargo" />
               </columns>
            </TableView>
            
            <!-- Station List -->
            <TableView fx:id="stationList" layoutX="820.0" layoutY="94.0" prefHeight="400.0" prefWidth="350.0">
               <columns>
                  <TableColumn fx:id="stationNameColumn" text="Station Name" />
                  <TableColumn fx:id="stationTypeColumn" text="Type" />
                  <TableColumn fx:id="stationCoordinatesColumn" text="Coordinates" />
               </columns>
            </TableView>
            <!-- Menu Bar -->
            <MenuBar layoutX="75.0" layoutY="30.0" prefHeight="40.0" prefWidth="700.0" style="-fx-background-color: #2c3e50; -fx-border-radius: 8; -fx-background-radius: 8;">
               <menus>
                  <!-- Menu Station -->
                  <Menu text="Station" style="-fx-text-fill: #ecf0f1; -fx-font-size: 16px;">
                     <items>
                        <MenuItem fx:id="buildStationMenuItem" text="Build Station" onAction="#handleBuildStation" />
                        <MenuItem fx:id="upgradeStationMenuItem" text="Upgrade Station" />
                        <MenuItem fx:id="listStationMenuItem" text="List Stations" />
                     </items>
                  </Menu>
                  <!-- Menu Train -->
                  <Menu text="Train" style="-fx-text-fill: #ecf0f1; -fx-font-size: 16px;">
                     <items>
                        <MenuItem fx:id="buyLocomotiveMenuItem" text="Buy Locomotive" />
                        <MenuItem fx:id="assignTrainMenuItem" text="Assign Train to Route" />
                     </items>
                  </Menu>
                  <!-- Menu Simulation -->
                  <Menu text="Simulation" style="-fx-text-fill: #ecf0f1; -fx-font-size: 16px;">
                     <items>
                        <MenuItem fx:id="startSimulationMenuItem" text="Start Simulation" onAction="#onStartSimulation" />
                        <MenuItem fx:id="pauseSimulationMenuItem" text="Pause Simulation" onAction="#onPauseSimulation" />
                     </items>
                  </Menu>
               </menus>
            </MenuBar>
            <Text layoutX="264.0" layoutY="10.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Menu Player" textAlignment="CENTER" wrappingWidth="256.3828125">
               <font>
                  <Font size="40.0" />
               </font>
            </Text>
      </children>
      </Pane>
   
      <!-- Status Label -->
      <Label fx:id="statusLabel" layoutX="20" layoutY="650" text="Status: Ready to play" />
      <!-- Ano Atual Label -->
      <Label fx:id="yearLabel" layoutX="20" layoutY="680" text="Ano atual: -" />
   </children>
</AnchorPane>
