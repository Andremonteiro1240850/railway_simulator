<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8" fx:controller="pt.ipp.isep.dei.ui.gui.PlayerController">
   <children>

      <!-- Map View -->
      <Pane fx:id="mapView" layoutY="50" prefHeight="600" prefWidth="800" style="-fx-background-color: #ecf0f1; -fx-border-radius: 8; -fx-background-radius: 8;">
         <children>
            <ImageView fx:id="mapImage" fitHeight="600" fitWidth="800" />

            <!-- Train List -->
            <TableView fx:id="trainList" layoutX="20.0" layoutY="150.0" prefHeight="300.0" prefWidth="350.0" style="-fx-background-color: #ffffff; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #7f8c8d, 10, 0.5, 0, 0);">
               <columns>
                  <TableColumn fx:id="trainNameColumn" text="Train Name" prefWidth="115" />
                  <TableColumn fx:id="locomotiveColumn" text="Locomotive Type" prefWidth="115" />
                  <TableColumn fx:id="cargoColumn" text="Current Cargo" prefWidth="115" />
               </columns>
            </TableView>

            <!-- Station List -->
            <TableView fx:id="stationList" layoutX="385.0" layoutY="150.0" prefHeight="300.0" prefWidth="350.0" style="-fx-background-color: #ffffff; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #7f8c8d, 10, 0.5, 0, 0);">
               <columns>
                  <TableColumn fx:id="stationNameColumn" text="Station Name" prefWidth="115" />
                  <TableColumn fx:id="stationTypeColumn" text="Type" prefWidth="115" />
                  <TableColumn fx:id="stationCoordinatesColumn" text="Coordinates" prefWidth="115" />
               </columns>
            </TableView>

            <!-- Menu Bar -->
            <MenuBar layoutX="75.0" layoutY="30.0" prefHeight="40.0" prefWidth="700.0" style="-fx-background-color: #34495e; -fx-border-radius: 8; -fx-background-radius: 8;">
               <menus>
                  <!-- Menu Station -->
                  <Menu text="Station" style="-fx-text-fill: #ecf0f1; -fx-font-size: 16px;">
                     <items>
                        <MenuItem fx:id="buildStationMenuItem" text="Build Station" onAction="#handleBuildStation" />
                        <MenuItem fx:id="upgradeStationMenuItem" text="Upgrade Station" />
                        <MenuItem fx:id="listStationMenuItem" text="List Stations" />
                     </items>
                  </Menu>
                  <!-- Menu Train -->
                  <Menu text="Train" style="-fx-text-fill: #ecf0f1; -fx-font-size: 16px;">
                     <items>
                        <MenuItem fx:id="buyLocomotiveMenuItem" text="Buy Locomotive" />
                        <MenuItem fx:id="assignTrainMenuItem" text="Assign Train to Route" />
                     </items>
                  </Menu>
                  <!-- Menu Simulation -->
                  <Menu text="Simulation" style="-fx-text-fill: #ecf0f1; -fx-font-size: 16px;">
                     <items>
                        <MenuItem fx:id="startSimulationMenuItem" text="Start Simulation" onAction="#onStartSimulation" />
                        <MenuItem fx:id="pauseSimulationMenuItem" text="Pause Simulation" onAction="#onPauseSimulation" />
                     </items>
                  </Menu>
               </menus>
            </MenuBar>

            <!-- Player Title -->
            <Text layoutX="264.0" layoutY="10.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Menu Player" textAlignment="CENTER" wrappingWidth="256.3828125" style="-fx-font-family: 'Arial'; -fx-font-weight: bold;">
               <font>
                  <Font size="40.0" />
               </font>
            </Text>
         </children>
      </Pane>

      <!-- Status Label -->
      <Label fx:id="statusLabel" layoutX="20" layoutY="650" text="Status: Ready to play" style="-fx-font-size: 16px; -fx-text-fill: #2c3e50;" />

      <!-- Ano Atual Label -->
      <Label fx:id="yearLabel" layoutX="20" layoutY="680" text="Ano atual: -" style="-fx-font-size: 16px; -fx-text-fill: #2c3e50;" />

      <!-- Budget Label -->
      <Label fx:id="budgetLabel" layoutX="250" layoutY="680" text="Budget: -" style="-fx-font-size: 16px; -fx-text-fill: #2c3e50;" />

   </children>
</AnchorPane>
