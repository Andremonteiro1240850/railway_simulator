<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8" fx:controller="pt.ipp.isep.dei.ui.gui.PlayerController" style="-fx-background-color: #f7f9fa;">
   <children>
      <!-- Título principal da tela -->
      <Label layoutX="0" layoutY="10" prefWidth="1.0E7" alignment="CENTER" text="Main Menu" style="-fx-font-family: 'Arial'; -fx-font-weight: bold; -fx-font-size: 44px; -fx-text-fill: #222;" />
      <!-- Título centralizado -->
      <Label layoutX="0" layoutY="60" prefWidth="1.0E7" alignment="CENTER" text="Scenario Map" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-padding: 24 0 24 0;" />
      <!-- MenuBar abaixo do título -->
      <MenuBar layoutX="100.0" layoutY="90.0" prefHeight="40.0" prefWidth="1200.0" stylesheets="@menu-bar-style.css">
         <menus>
            <!-- Menu Station -->
            <Menu text="Station" style="-fx-font-size: 16px;">
               <items>
                  <MenuItem fx:id="buildStationMenuItem" text="Build Station" onAction="#handleBuildStation" />
                  <MenuItem fx:id="upgradeStationMenuItem" text="Upgrade Station" onAction="#handleUpgradeStation" />
                  <MenuItem fx:id="listStationMenuItem" text="List Stations" onAction="#handleListStations" />
               </items>
            </Menu>
            <!-- Menu Train -->
            <Menu text="Train" style="-fx-font-size: 16px;">
               <items>
                  <MenuItem fx:id="buyLocomotiveMenuItem" text="Buy Locomotive" onAction="#handleBuyLocomotive" />
                  <MenuItem fx:id="assignTrainMenuItem" text="Assign Train to Route" onAction="#handleAssignTrainToRoute" />
               </items>
            </Menu>
            <!-- Menu Simulation -->
            <Menu text="Simulation" style="-fx-font-size: 16px;">
               <items>
                  <MenuItem fx:id="saveGameMenuItem" text="Save Game" onAction="#handleSaveGame" />
                  <MenuItem fx:id="loadGameMenuItem" text="Load Game" onAction="#handleLoadGame" />
                  <MenuItem fx:id="startSimulationMenuItem" text="Start Simulation" onAction="#onStartSimulation" />
                  <MenuItem fx:id="pauseSimulationMenuItem" text="Pause Simulation" onAction="#onPauseSimulation" />
                  <MenuItem fx:id="financialResultsMenuItem" text="Financial Results" onAction="#showFinancialResults" />
               </items>
            </Menu>
         </menus>
      </MenuBar>
      <!-- ScrollPane para o mapa e legenda -->
      <ScrollPane layoutX="40" layoutY="130" prefHeight="700" prefWidth="850" fitToWidth="true" fitToHeight="false" style="-fx-background-color:transparent;">
         <VBox alignment="TOP_CENTER" spacing="10">
            <Label fx:id="mapTitleLabel" text="Scenario Map" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-padding: 24 0 24 0;" />
            <!-- Moldura de fundo do mapa centralizada -->
            <HBox alignment="CENTER">
               <Pane prefHeight="540" prefWidth="740" style="-fx-background-color: #d6dbe2; -fx-background-radius: 16; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, #b0b0b0, 20, 0.2, 0, 0);">
                  <!-- Mapa visual centralizado dentro da moldura -->
                  <Pane fx:id="mapView" layoutX="20" layoutY="20" prefHeight="500" prefWidth="700" style="-fx-background-color: #ecf0f1; -fx-border-radius: 8; -fx-background-radius: 8;" />
               </Pane>
            </HBox>
            <!-- Legenda do mapa -->
            <VBox spacing="6" alignment="CENTER_LEFT">
               <Label text="Legenda do Mapa:" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
               <Label text="● City:" style="-fx-font-size: 15px; -fx-text-fill: #000000;" />
               <Label text="- ■ House Bolcks" style="-fx-font-size: 15px; -fx-text-fill: #555;" />
               <Label text="▲ Industry" style="-fx-font-size: 15px; -fx-text-fill: #228B22;" />
               <Label text="Stations Type:" style="-fx-font-size: 15px; -fx-text-fill: #555;" />
               <Label text="- ■ Depot" style="-fx-font-size: 15px; -fx-text-fill: #00BFFF;" />
               <Label text="- ■ Terminal" style="-fx-font-size: 15px; -fx-text-fill: #A020F0;" />
               <Label text="- ■ Station" style="-fx-font-size: 15px; -fx-text-fill: #FF0000;"  />
               <Label text="● Train" style="-fx-font-size: 15px; -fx-text-fill: #FFA500;" />
            </VBox>
            <Region prefHeight="60" />
         </VBox>
      </ScrollPane>
      <!-- Painel de tabelas à direita -->
      <VBox layoutX="1000" layoutY="160" spacing="8" prefWidth="370" >
         <VBox spacing="4">
            <Label fx:id="statusLabel" prefWidth="350" style="-fx-font-size: 16px; -fx-text-fill: #2c3e50;" />
            <Label fx:id="budgetLabel" prefWidth="350" style="-fx-font-size: 16px; -fx-text-fill: #2c3e50;" />
            <Label fx:id="yearLabel" prefWidth="350" style="-fx-font-size: 16px; -fx-text-fill: #2c3e50;" />
         </VBox>
         <ScrollPane prefHeight="700" prefWidth="370" fitToWidth="true" style="-fx-background-color:transparent;">
            <VBox spacing="24">
               <Label text="Trains" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
               <TableView fx:id="trainList" prefHeight="100.0" prefWidth="350.0">
                  <columns>
                     <TableColumn fx:id="trainNameColumn" text="Train Name" prefWidth="120" />
                     <TableColumn fx:id="locomotiveColumn" text="Locomotive Type" prefWidth="130" />
                     <TableColumn fx:id="cargoColumn" text="Current Cargo" prefWidth="130" />
                  </columns>
               </TableView>
               <Label text="Stations" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
               <TableView fx:id="stationList" prefHeight="100.0" prefWidth="350.0">
                  <columns>
                     <TableColumn fx:id="stationNameColumn" text="Station Name" prefWidth="120" />
                     <TableColumn fx:id="stationTypeColumn" text="Type" prefWidth="130" />
                     <TableColumn fx:id="stationCoordinatesColumn" text="Coordinates" prefWidth="130" />
                  </columns>
               </TableView>
               <Label text="Cities" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
               <TableView fx:id="citiesList" prefHeight="100.0" prefWidth="350.0">
                  <columns>
                     <TableColumn fx:id="cityNameColumn" text="Name" prefWidth="120" />
                     <TableColumn fx:id="cityBlocksColumn" text="House Blocks" prefWidth="130" />
                     <TableColumn fx:id="cityCoordinatesColumn" text="Coordinates" prefWidth="130" />
                  </columns>
               </TableView>
               <Label text="Locomotive Inventory" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
               <TableView fx:id="locomotiveInventory" prefHeight="100.0" prefWidth="350.0">
                  <columns>
                     <TableColumn fx:id="locomotiveNameColumn" text="Name" prefWidth="120" />
                     <TableColumn fx:id="locomotiveTypeColumn" text="Type" prefWidth="130" />
                     <TableColumn fx:id="locomotivePowerColumn" text="Power" prefWidth="130" />
                  </columns>
               </TableView>
               <Label text="Industries" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
               <TableView fx:id="industriesList" prefHeight="100.0" prefWidth="350.0">
                  <columns>
                     <TableColumn fx:id="industryNameColumn" text="Name" prefWidth="120" />
                     <TableColumn fx:id="industryTypeColumn" text="Type" prefWidth="130" />
                     <TableColumn fx:id="industryCoordinatesColumn" text="Coordinates" prefWidth="130" />
                  </columns>
               </TableView>
               <Region prefHeight="200" />
               <Region VBox.vgrow="ALWAYS" />
            </VBox>
         </ScrollPane>
      </VBox>
   </children>
   <children>
      <Region layoutY="1000" prefHeight="60" prefWidth="1600" />
   </children>
</AnchorPane>
