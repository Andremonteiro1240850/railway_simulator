@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

    class User {
        type
    }

    class Editor {
        ID
    }

    class Player {
        name
        email
        password
    }

    class ProductOwner {
        name
    }

    User --> Editor: "can be"
    User --> Player: "can be"
    User --> ProductOwner: "can be"


    class Map {
        name
        width
        height
    }

    class City {
        name
        houseBlocks
    }

    class Industry {
        type
    }

    class Position {
        x
        y
    }

    Map  -->  City : "have"
    Map  -->  Industry : "have"
    City --> Position: "have"
    Industry --> Position: "have"
    Editor --> Map : "create"


    class Scenario {
        timePeriod
        availableLocomotives
    }

    class PortBehavior {
        imports
        exports
    }

    Editor --> Scenario :"create"
    Scenario  -->  PortBehavior: "have"


    class Station {
        name
        type
        economicRadius
    }

    class RailwayLine {
        length
        isElectrified
        isDoubleTrack
    }

    class Train {
        route
    }

    class Route {
        stations
        cargos
    }

    class Balance{
    currentBalance
    }
    class Inventory{
    ownedBuildings
    ownedLocomotives
    ownedCarriages
    }
    class Simulator{
    run
    date
    }
    class Cargo{
    type
    quantity
    departure
    arrival
    }
    class Locomotives {
    type
    price
    speed
    name
    maintenanceCost
    yearStart
    acelaration
    }
    class Steam{
    }
    class Fuel{
    }
    class Electricity{
    }
    class Carriage{
    type
    capacity
    }
    class PassengerCarriage{
    capacity
    }
    class CargoCarriage{
    capacity
    }
    class Depot{
    cost
    radius

    }
    class NormalStation{
    radius
    centre
    cost
    }
    class Terminal{
    cost
    radius
    }
    class Building{
    type
    cost
    }
    class Telegraph{
    cost
    type
    }
    class Cafe{
    cost
    size
    }
    class Silo{
    cost
    }
    class Hotel{
    cost
    size
    }
    class PostOffice {
    cost
    }
    class Custom {
    cost
    }
    class LiquidStorage {
    cost
    }
    class Primary{
    resource
    }
    class Transform{
    imports
    export
    }
    class Mixed{
    imports
    export
    }













    Player --> Station: "own"
    Station  --> RailwayLine :"have"
    RailwayLine  -->  Station : "connect"
    Train  -->  Route :"have"
    Player --> Train : "have"
    Player --> Balance : "have"
    Player --> Inventory : "have"
    ProductOwner --> Simulator : "own"
    Simulator --> Cargo : "have"
    Simulator --> Station : "generated in"
    Train --> Locomotives : "have"
    Locomotives --> Steam :"can be"
    Locomotives --> Fuel: "can be"
    Locomotives --> Electricity: "can be"
    Train --> Carriage : "have"
    Carriage --> CargoCarriage: "can be"
    Carriage --> PassengerCarriage: "can be"
    Station --> Terminal: "can be"
    Station --> Depot: "can be"
    Station --> NormalStation: "can be"
    Station --> Building : "can have"
    Building --> Telegraph: "can be"
    Building --> Custom: "can be"
    Building --> Cafe: "can be"
    Building --> Hotel: "can be"
    Building --> PostOffice: "can be"
    Building --> LiquidStorage: "can be"
    Industry --> Primary: "can be"
    Industry --> Mixed: "can be"
    Industry --> Transform: "can be"
    Building --> Silo: "can be""

@enduml