@startuml
'https://plantuml.com/use-case-diagram

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0
hide circle
hide methods

class Editor {
  Name
  Email
  Position
  Phone
}

class Map {
  Reference
  Description
  Size
  Name
}

class Industry {
  Type
  Position XY
}

Editor "*" -- "1" Map : Selects
Editor "*" -- "1" Industry :Adds
Map "1" -- "*" Industry : Contains

@enduml
