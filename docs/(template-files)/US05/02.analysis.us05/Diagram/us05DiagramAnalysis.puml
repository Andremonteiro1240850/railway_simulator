@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model

class Organization {
    name
    vatNumber
    website
    phoneNumber
    email
}

class Task {
    map
    type of building
    centre
