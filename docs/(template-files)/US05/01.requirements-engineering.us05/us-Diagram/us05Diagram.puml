@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Employee
participant ":System" as System

activate Employee

    Employee -> System : Ask to build a station
    activate System

        System --> Employee : Verify if is alowed to build a station
    deactivate System

    Employee -> System : select build category
    activate System

        System --> Employee :  Request information (Location))
    deactivate System

    Employee -> System : Give location
    activate System

        System --> Employee : shows all the information given
    deactivate System

    Employee -> System : confirms information
    activate System

        System --> Employee : displays operation success
    deactivate System
@enduml