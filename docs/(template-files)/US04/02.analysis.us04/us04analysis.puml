@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model

class Organization {
    name
    vatNumber
    website
    phoneNumber
    email
}

class Map {
    name
    size
}

class Editor {
    name
    email
}

class City {
    name
    positionXY
    houseBlocks
}

class Scenario {
    name
    description
}

Organization "1" - "*" Editor : Has
Organization "1" - "*" Map : Owns
Editor "1" -- "*" City : Adds
Map "1" -- "*" City : Contains
Editor "1" -- "*" Scenario : creates
Map "1" -- "*" Scenario : has

@enduml
