@startuml
' Estilo visual
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

left to right direction
hide circle
hide methods
title Domain Model - Buy a Train

class Player {
  name
}

class Locomotive {
  model
  power
  capacity
  available
}

class TrainPurchase {
  purchaseDate
}

Player "1" -- "1" TrainPurchase : makes
TrainPurchase "*" -- "1" Locomotive : selects

@enduml
