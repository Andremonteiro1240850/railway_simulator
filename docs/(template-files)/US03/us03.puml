@startuml
'https://plantuml.com/use-case-diagram

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0
hide circle
hide methods

class Editor {
  Name
  Email
  Position
  Phone
}

class Map {
  Reference
  Description
  Size
  Name
}

class City {
  Name
  Position XY
  House Blocks
}

Editor "*" -- "1" Map : Selects
Editor "*" -- "1" City : Adds
Map "1" -- "*" City : Contains

note right of City
  - Name cannot have special characters or digits
  - House blocks must be positive
  - House blocks can be assigned manually or randomly
end note

@enduml
