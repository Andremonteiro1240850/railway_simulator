@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model

class Organization {
    Name
    vat Number
    Website
    Phone Number
    Email
}

class Map {
    Name
    Size
}

class Editor {
    Name
    Email
}

class City {
    Name
    Position XY
    House Blocks
}

Organization "1" - "*" Editor : Has
Organization "1" -- "*" Map : Owns
Editor "1" -- "*" City : Adds
Map "1" -- "*" City : Contains

@enduml
