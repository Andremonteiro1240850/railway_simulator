@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Employee
participant ":System" as System

activate Employee

    Employee -> System : asks to upgrade a station
    activate System

        System --> Employee : shows task category list and asks to select one
    deactivate System

    Employee -> System : selects a task "upgrade"
    activate System

        System --> Employee : requests data (i.e. building, cost)
    deactivate System

    Employee -> System : types requested data
    activate System

        System --> Employee : shows all data and requests confirmation
    deactivate System

    Employee -> System : confirms data
    activate System

        System --> Employee : displays operation success
    deactivate System
@enduml