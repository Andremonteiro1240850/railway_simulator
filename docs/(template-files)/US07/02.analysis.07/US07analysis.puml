@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods


class Player {
    id
    name
}

class Station {
    id
    name
    location
}

class Building {
    id
    type
    level
    cost
}

class Upgrade {
    timestamp
    status
}

Player -- "1" Upgrade : performs
Upgrade -- "1" Station : targets
Upgrade -- "1" Building : applies

@enduml
