@startuml
class Player {
    +id
    +name
}

class Station {
    +id
    +name
    +location
}

entity Building {
    +id
    +type
    +level
    +cost
}

entity Upgrade {
    +timestamp
    +status
}

Player -- "1" Upgrade : performs
Upgrade -- "1" Station : targets
Upgrade -- "1" Building : applies

@enduml