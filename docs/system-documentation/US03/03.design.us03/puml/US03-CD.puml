@startuml
'https://plantuml.com/class-diagram

skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0


class AddCityUI {
  + startAddCity()
  + requestCityName(): String
  + requestCoordinates(): (int, int)
  + requestHouseBlocks(): int
  + requestDistributionType(): String
  + showSuccessOrError(result: boolean)
}

class AddCityController {
  + handleAddCity(name: String, x: int, y: int, blocks: int, type: String)
  - validateCityName(name: String): boolean
  - validateDistributionType(type: String): boolean
  - validateHouseBlockCount(blocks: int): boolean
}

class CreateMapRepository {
  + getCurrentMap(): Map
  + save(map: Map): boolean
}

class Map {
  + isPositionWithinBounds(x: int, y: int): boolean
  + isPositionFree(x: int, y: int): boolean
  + addCity(city: City): boolean
}

class City {
  + City(name: String, x: int, y: int)
  + assignHouseBlocks(blocks: int)
  + assignHouseBlocksRandomly(blocks: int)
}

AddCityUI --> AddCityController
AddCityController --> CreateMapRepository
AddCityController --> Map
AddCityController --> City

@enduml
