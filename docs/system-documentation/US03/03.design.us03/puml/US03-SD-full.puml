@startuml
'https://plantuml.com/sequence-diagram
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false


actor Editor
participant "AddCityUI" as UI
participant AddCityController
participant CreateMapRepository
participant Map
participant City

autonumber

Editor -> UI : Start "Add City" process
activate UI

UI --> Editor : Display Available Maps
Editor -> UI : Select Map

UI --> Editor : Request City Name
Editor -> UI : Input City Name

UI --> Editor : Request XY Coordinates
Editor -> UI : Input XY

UI --> Editor : Request House Blocks Count
Editor -> UI : Input House Blocks

UI --> Editor : Request Distribution Type (Manual/Auto)
Editor -> UI : Input Distribution Type

UI -> AddCityController : handleAddCity(name, x, y, houseBlocks, distributionType)
activate AddCityController

AddCityController -> CreateMapRepository : getCurrentMap()
activate CreateMapRepository
CreateMapRepository --> AddCityController : currentMap
deactivate CreateMapRepository

group **Validation**
  AddCityController -> AddCityController : validateCityName(name)
  note right: AC01: Rejects special chars/digits
  AddCityController -> Map : isPositionValid(x, y)
  activate Map
  Map --> AddCityController : isValidPosition
  deactivate Map
end group

group **City Creation**
  AddCityController -> City : new(name, x, y)
  activate City
  alt distributionType == "Manual"
    City -> City : assignHouseBlocks(houseBlocks)
  else
    City -> City : assignHouseBlocksRandomly(houseBlocks)
    note right: AC02: Normal distribution
  end
  City --> AddCityController : cityInstance
  deactivate City
end group

AddCityController -> Map : addCity(cityInstance)
activate Map
Map --> AddCityController : isAdded
deactivate Map

AddCityController -> CreateMapRepository : save(currentMap)
activate CreateMapRepository
CreateMapRepository --> AddCityController : isSaved
deactivate CreateMapRepository

AddCityController --> UI : result(success/failure)
deactivate AddCityController

UI -> Editor : Show Confirmation
deactivate UI

@enduml