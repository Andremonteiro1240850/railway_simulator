@startuml
'https://plantuml.com/class-diagram

skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class AddIndustryUI {
  + startAddIndustry()
  + requestMapSelection()
  + inputPositionAndType(x: int, y: int, type: IndustryType)
  + showSuccess(industry: Industry)
  + showError(message: String)
}

class AddIndustryController {
  + verifyEditorPermission(editor: Editor): boolean
  + requestMapSelection()
  + validateIndustry(type: IndustryType, x: int, y: int): boolean
  + createIndustry(type: IndustryType, x: int, y: int): Industry
}

class UserService {
  + verifyEditorPermission(editor: Editor): boolean
}

class CreateMapRepository {
  + getMapById(mapId: String): Map
  + saveMap(map: Map): boolean
}

class IndustryTypeRepository {
  + isValidIndustryType(type: IndustryType): boolean
   PRIMARY
   TRANSFORMING
   MIXED
}

class Map {
  - id: String
  - industries: List<Industry>
  + isPositionValid(x: int, y: int): boolean
  + addIndustry(industry: Industry): boolean
}

class Industry {
  - type: IndustryType
  - x: int
  - y: int
  + create(type: IndustryType, x: int, y: int)
}

class IndustryRepository {
    + getCurrentIndustry(): Industry
    + save(industry: Industry): boolean
}


' Relationships
AddIndustryUI --> AddIndustryController : triggers >
AddIndustryController --> UserService : checks permissions >
AddIndustryController --> CreateMapRepository : retrieves/saves >
AddIndustryController --> IndustryTypeRepository : validates type >
AddIndustryController --> Map : validates position/adds industry >
AddIndustryController --> Industry : creates >
AddIndustryController --> IndustryRepository : saves in


note top of IndustryTypeRepository: "Validates if type matches\nscenario restrictions (US02)"
note right of Map :isPositionValid: "Checks:\n- Boundaries\n- Overlaps (AC01)"
@enduml