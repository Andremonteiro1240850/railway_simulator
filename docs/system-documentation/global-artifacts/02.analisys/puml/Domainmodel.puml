@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

class Map {
    name

}
class Dimension{
    width
    length
}
class Position{
    positionX
    positionY
}

class Industry {
    name
    type

}

class City {
    name
}

class HouseBlock {
inhabitants
}

class Scenario {
    description
}
class Date{
startYear
currentYear
endYear
}

class Station {
    name
    capacity
    demand
    supply

}
class StationType{
radius
price
}


class Building{
effect
type
price
}
class RailwayLine {
    length
    isElectrified
    isDoubleTrack

}

class Locomotive {
    name
    power
    acceleration
    topSpeed
    fuelCost
    maintenanceCost
    price

}

class Carriage {
    type
    capacity
}

class Train {
    name
}

class Cargo {
    type
    quantity
}

class Route {

}

class Player{
id
}

class Editor{
id

}

class Budget{
balance
}

class Inventory{
}

class Simulation{
isRunning
}



' Relationships

Player "1" -- "1" Inventory :  owns >
Inventory "1" -- "*" Building :  stores >
Inventory "1" -- "*" Locomotive :  stores >
Inventory "1" -- "*" Industry :  stores >
Map "1" -- "1" Dimension :  has >
Map "1" -- "*" Industry : contains >
Map "1" -- "*" City : contains >
City "1" -- "1" Position :  located at >
Industry "1" -- "1" Position :  located at >
HouseBlock "1" -- "1" Position :  located at >
Station "1" -- "1" Position :  located at >
Building "*" -- "1" Simulation :  depends on >
City "1" -- "*" HouseBlock : has >
Scenario "1" -- "*" Map : applies to >
Scenario "1" -- "*" Locomotive : restricts >
Scenario "1" -- "*" Building : restricts >
Scenario "1" -- "1" Date : has >
Station "1" -- "*" Building : upgraded with >
Station "1" -- "*" Cargo : handles >
Station "1" -- "*" RailwayLine : connected by >
Locomotive "1" -- "1" Date : has >
Train "1" -- "1" Locomotive : powered by >
Train "1" -- "*" Carriage : consists of >
Train "1" -- "1" Route : follows >
Train "1" -- "*" Cargo : transports >
Route "1" -- "*" Cargo : handles >
Route "1" -- "1" Station : starts at >
Route "1" -- "1" Station : finish at >
Route "1" -- "*" Station : passes by >
Industry "1" -- "*" Cargo : produces >
City "1" -- "*" Cargo : demands >
Editor "1" -- "*" Map : creates >
Editor "1" -- "*" Scenario : creates >
Player "1" -- "*" Station : builds/views >
Player "1" -- "*" RailwayLine : builds >
Player "1" -- "*" Train : owns >
Player "1" -- "1" Budget : has >
Simulation "1" -- "*" Cargo : generates >
Simulation "1" -- "*" Station : generates at >
Simulation "1" -- "1" Date : has >

class PrimaryIndustry {
    resource
    productionRate
    price
}

class TransformingIndustry {
    import
    export
    conversionRate
    price
}

class MixedIndustry {
    import
    export
    price
}

Industry <|-- PrimaryIndustry
Industry <|-- TransformingIndustry
Industry <|-- MixedIndustry

Station <|-- StationType

class PassengerCarriage {
    seatCount
}

class FreightCarriage {
    cargoType
    capacity
}

Carriage <|-- PassengerCarriage
Carriage <|-- FreightCarriage

class SteamLocomotive {
    coalConsumption
}

class DieselLocomotive {
    fuelConsumption
}

class ElectricLocomotive {
    powerConsumption
}

Locomotive <|-- SteamLocomotive
Locomotive <|-- DieselLocomotive
Locomotive <|-- ElectricLocomotive

@enduml