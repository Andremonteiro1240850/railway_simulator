@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

class Map {
    name
}
class Dimension{
    width
    length
}
class Position{
    positionX
    positionY
}

class Industry {
    name
}

class City {
    name
}

class HouseBlock {
    inhabitants
}

class Scenario {
    description
    startYear
    endYear
}

class StationType {
    type
    radius
    price
}

class Station {
    name
    capacity
    demandPerCargoType
    supplyPerCargoType
}

class Building {
    effect
    type
    price
}

class RailwayLine {
    length
    isElectrified
    isDoubleTrack
}

class Locomotive {
    name
    power
    acceleration
    topSpeed
    fuelCost
    maintenanceCost
    price
    startYearOfOperation
}

class Carriage {
    type
    capacity
}

class Train {
    name
}

class Cargo {
    type
    quantity
    status
}

class Route {
}

class Player{
    id
}

class Editor{
    id
}

class Budget{
    balance
}

class Inventory{
}

class Simulation{
    isRunning
    currentYear
}


' Relationships

Player "1" -- "1" Budget : has >
Player "1" -- "1" Inventory : owns >
Inventory "1" -- "*" Building : stores >
Inventory "1" -- "*" Locomotive : stores >
Map "1" -- "1" Dimension : has >
Map "1" -- "*" Industry : contains >
Map "1" -- "*" City : contains >
City "1" -- "1" Position : located at >
Industry "1" -- "1" Position : located at >
HouseBlock "1" -- "1" Position : located at >
Station "1" -- "1" Position : located at >
Station "1" -- "1" StationType : is of type >
City "1" -- "*" HouseBlock : has >
Scenario "1" -- "1" Map : applies to >
Scenario "1" -- "*" Locomotive : restricts >
Scenario "1" -- "*" Building : restricts >
Station "1" -- "*" Building : upgraded with >
Station "1" -- "*" RailwayLine : connected by >
Train "1" -- "1" Locomotive : powered by >
Train "1" -- "*" Carriage : consists of >
Train "1" -- "1" Route : follows >
Train "1" -- "*" Cargo : transports >
Route "1" -- "1" Station : starts at >
Route "1" -- "1" Station : finish at >
Route "1" -- "*" Station : passes by >
Industry "1" -- "*" Cargo : produces >
City "1" -- "*" Cargo : demands >
Editor "1" -- "*" Map : creates >
Editor "1" -- "*" Scenario : creates >
Player "1" -- "*" Station : builds/views >
Player "1" -- "*" RailwayLine : builds >
Player "1" -- "*" Train : owns >
Simulation "1" -- "1" Scenario : runs for >


' Generalization

Industry <|-- PrimaryIndustry
Industry <|-- TransformingIndustry
Industry <|-- MixedIndustry

class PrimaryIndustry {
    resource
    productionRate
    price
}

class TransformingIndustry {
    import
    export
    conversionRate
    price
}

class MixedIndustry {
    import
    export
    price
}

class PassengerCarriage {
    seatCount
}

class FreightCarriage {
    cargoType
}

Carriage <|-- PassengerCarriage
Carriage <|-- FreightCarriage

class SteamLocomotive {
    coalConsumption
}

class DieselLocomotive {
    fuelConsumption
}

class ElectricLocomotive {
    powerConsumption
}

Locomotive <|-- SteamLocomotive
Locomotive <|-- DieselLocomotive
Locomotive <|-- ElectricLocomotive

' Additional relationships (simplified)
Station "1" -- "*" Cargo : holds >
Station "1" -- "0..1" City : serves >
Station "1" -- "0..1" Industry : serves >
@enduml