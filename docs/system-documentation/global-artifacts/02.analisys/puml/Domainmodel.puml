@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

    class User {
        type
    }

    class Editor {
        email
        password
    }

    class Player {

        email
        password
    }
    Player-->Scenario:"plays in"
    Player --> Locomotives:"purchase"

    class ProductOwner {
        name
    }

    User --> Editor: "can be"
    User --> Player: "can be"
    User --> ProductOwner: "can be"


    class Map {
        name
        width
        height

    }

    class City {
        name
        houseBlocks
    }

    class Industry {
        type
    }

    class Position {
        x
        y
        z
    }

    Map  -->  City : "have"
    Map  -->  Industry : "have"
    City --> Position: "have"
    Industry --> Position: "have"
    Editor --> Map : "create"


    class Scenario {
        name
        timePeriod
        availableLocomotives
        generatingFactors
    }
    Scenario --> Map :"use"

    class PortBehavior {
        imports
        exports
        trasnsform
    }

    Editor --> Scenario :"create"
    Scenario  -->  PortBehavior: "have"


    class Station {
        name
        type
        economicRadius
        buildings
        cargoDemand
        cargoSuply
    }
    class StationType {
    Depot
    Station
    Terminal
    }
    Station --> StationType: "have"

    class RailwayLine {
        length
        isElectrified
        isDoubleTrack
    }

    class Train {
        id
        locomotive
        carriage
        route
    }

    class Route {
        stations
        cargos
    }

    class Balance{
    currentBalance
    }
    class Inventory{
    ownedBuildings
    ownedLocomotives
    ownedCarriages
    }
    class Simulator{
    run
    date
    }
    class Cargo{
    type
    quantity
    departure
    arrival
    }
    class Locomotives {
    type
    price
    speed
    name
    maintenanceCost
    yearStart
    acelaration
    }
    class LocomotiveType{
    Steam
    Diesel
    Electricity
    }
    Locomotives --> LocomotiveType: "have"
    class Carriage{
    type
    capacity
    }
    class PassengerCarriage{
    capacity
    }
    class CargoCarriage{
    capacity
    }
    class Building{
    type
    cost
    }
    class BuildingType{
            Telegraph
            Telephone
            SmallHotel
            GrandHotel
            Silo
            LiquidStorage
            Cafe
            PostOffice

    }
    Building --> BuildingType:"have"
   class IndustryType{
   Primary
   Transforming
   Mixed
   }
   Industry --> IndustryType: "have"












    Player --> Station: "List"
    Player --> Station: "own"
    RailwayLine  -->  Station : "connect"
    Train  -->  Route :"assign"
    Player --> Train : "have"
    Player --> Balance : "have"
    Player --> Inventory : "have"
    ProductOwner --> Simulator : "own"
    Simulator --> Cargo : "have"
    Train --> Locomotives : "have"
    Train --> Carriage : "have"
    Carriage --> CargoCarriage: "can be"
    Carriage --> PassengerCarriage: "can be"
    Station --> Building : "upgrade with"
    City --> Station: "have"
    Scenario --> Train: "create"
    Scenario --> Inventory: "have"
    Scenario --> Locomotives: "need"
    Station --> Position: "have"
    Train --> Cargo: "Picks"
    Route --> Station: "have"
    Simulator --> Station: "generate"
    Train --> RailwayLine: "Travel for"
    Station --> City: "Serve"
    Station --> Industry: "Serve"





@enduml