@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Employee
participant ":System" as System

activate Employee

    Employee -> System : ask to upgrade a station
    activate System

        System --> Employee : shows available stations
    deactivate System

    Employee -> System : select station
    activate System

        System --> Employee : requests building type
    deactivate System

    Employee -> System : select building
    activate System

        System --> Employee : shows all data and requests confirmation
    deactivate System

    Employee -> System : confirms data
    activate System

        System --> Employee : displays operation success and upgrade station
    deactivate System
@enduml