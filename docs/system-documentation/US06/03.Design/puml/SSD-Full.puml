
@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

hide footbox
actor "Player" as PLAYER

participant ":UpgradeStationUI" as UI
participant ":UpgradeStationController" as CTRL
participant ":StationRepository" as STATION_REPO
participant ":UpgradeBuildingsRepository" as BUILDING_REPO
participant ":ScenarioRepository" as SCENARIO_REPO
participant "station:Station" as STATION_OBJ #LightBlue
participant "scenario:Scenario" as SCENARIO_OBJ #LightBlue

' DTOs adicionados
participant "StationDTO" as STATION_DTO #LightGreen
participant "UpgradeOptionDTO" as UPGRADE_DTO #LightGreen

activate PLAYER

PLAYER -> UI : asks to upgrade a station
activate UI
    UI --> CTRL : initialize()
    activate CTRL
    CTRL --> UI : initializationComplete
    deactivate CTRL

    UI -> CTRL : getAvailableStations()
    activate CTRL
        CTRL -> STATION_REPO : getAll()
        activate STATION_REPO
        STATION_REPO --> CTRL : List<Station>
        deactivate STATION_REPO

        CTRL -> STATION_DTO : convert(List<Station>)
        activate STATION_DTO
        STATION_DTO --> CTRL : List<StationDTO>
        deactivate STATION_DTO
        CTRL --> UI : List<StationDTO>
    deactivate CTRL

    UI --> PLAYER : show available stations
deactivate UI

PLAYER -> UI : selects station
activate UI
    UI -> CTRL : getAvailableUpgradeTypes()
    activate CTRL
        CTRL -> BUILDING_REPO : getAllUpgradeTypes()
        activate BUILDING_REPO
        BUILDING_REPO --> CTRL : List<String>
        deactivate BUILDING_REPO

        CTRL -> UPGRADE_DTO : wrap(List<String>)
        activate UPGRADE_DTO
        UPGRADE_DTO --> CTRL : List<UpgradeOptionDTO>
        deactivate UPGRADE_DTO
        CTRL --> UI : List<UpgradeOptionDTO>
    deactivate CTRL

    UI --> PLAYER : requests upgrade type
deactivate UI

PLAYER -> UI : selects upgrade type
activate UI
    UI -> CTRL : getAvailableSubTypes(type : String)
    activate CTRL

    alt BUILDING_REPO.acceptsSubTypes(type)
        CTRL -> BUILDING_REPO : getAllSubTypes()
        activate BUILDING_REPO
        BUILDING_REPO --> CTRL : List<String>
        deactivate BUILDING_REPO

        CTRL -> UPGRADE_DTO : wrap(List<String>)
        activate UPGRADE_DTO
        UPGRADE_DTO --> CTRL : List<UpgradeOptionDTO>
        deactivate UPGRADE_DTO
        CTRL --> UI : List<UpgradeOptionDTO>
    else
        CTRL --> UI : empty list : List<UpgradeOptionDTO>
    end
    deactivate CTRL

    UI --> PLAYER : requests subtype (if applicable)
deactivate UI

PLAYER -> UI : selects subtype (optional)
activate UI
    UI --> PLAYER : shows summary and requests confirmation
deactivate UI

PLAYER -> UI : confirms upgrade
activate UI
    UI -> CTRL : upgradeStation(dto : UpgradeOptionDTO)
    activate CTRL

        CTRL -> STATION_REPO : findByReference(stationId)
        activate STATION_REPO
        STATION_REPO --> CTRL : Optional<Station>
        deactivate STATION_REPO

        CTRL -> STATION_OBJ : hasUpgrade(type, subType)
        activate STATION_OBJ
        STATION_OBJ --> CTRL : boolean
        deactivate STATION_OBJ

        CTRL -> STATION_REPO : findScenarioByStation(stationId)
        activate STATION_REPO
        STATION_REPO --> CTRL : Optional<Scenario>
        deactivate STATION_REPO

        CTRL -> SCENARIO_OBJ : canAfford(price)
        activate SCENARIO_OBJ
        SCENARIO_OBJ --> CTRL : boolean
        deactivate SCENARIO_OBJ

        opt if (validUpgrade && !upgradeExists && sufficientBudget)
            CTRL -> STATION_OBJ : addUpgrade(type, subType)
            activate STATION_OBJ
            STATION_OBJ --> CTRL : success
            deactivate STATION_OBJ

            CTRL -> STATION_REPO : addUpgradeToStation(stationId, stationUpgrade)
            activate STATION_REPO
            STATION_REPO --> CTRL : success
            deactivate STATION_REPO

            CTRL -> SCENARIO_OBJ : deductBudget(price)
            activate SCENARIO_OBJ
            SCENARIO_OBJ --> CTRL : success
            deactivate SCENARIO_OBJ
        end

        CTRL --> UI : upgradeStatus : boolean
    deactivate CTRL
    UI --> PLAYER : displays upgrade result
deactivate UI

deactivate PLAYER
@enduml
