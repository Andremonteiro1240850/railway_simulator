@startuml
skinparam monochrome false
skinparam packageStyle rectangle
skinparam shadowing false

class Player {
}

class UpgradeStationUI {
  + askToUpgradeStation()
  + showAvailableStations()
  + requestBuildingType()
  + showUpgradeSummary()
  + displayUpgradeResult()
}

class UpgradeStationController {
  + initialize()
  + getStations()
  + selectUpgradeBuilding()
  + executeUpgrade()
}



class PlayerRepository {
  + getCurrentPlayer()
}

class StationRepository {
  + getStationsByPlayer()
}

class BuildingRepository {
  + getBuildingsByType()
}


class Organization{
  + verifyIfPossible()
}

class StationUpgrader {
  + applyUpgrade()
}

' Relacionamentos
Player --> UpgradeStationUI : usa
UpgradeStationUI --> UpgradeStationController : comunicate

UpgradeStationController --> PlayerRepository : goes
UpgradeStationController --> StationRepository : goes
UpgradeStationController --> BuildingRepository : goes
UpgradeStationController --> StationRepository : verify
UpgradeStationController --> Organization : verify
UpgradeStationController --> StationUpgrader : create
StationUpgrader --> StationRepository: save on
BuildingRepository --> StationUpgrader: get building






@enduml


