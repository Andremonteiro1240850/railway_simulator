@startuml
skinparam monochrome false
skinparam packageStyle rectangle
skinparam shadowing false

class Player {
}

class UpgradeStationUI {
  + askToUpgradeStation()
  + showAvailableStations()
  + requestBuildingType()
  + showUpgradeSummary()
  + displayUpgradeResult()
}

class UpgradeStationController {
  + initialize()
  + getStations()
  + selectUpgradeBuilding()
  + executeUpgrade()
}



class PlayerRepository {
  + getCurrentPlayer()
}

class StationRepository {
  + getStationsByPlayer()
}

class BuildingRepository {
  + getBuildingsByType()
}


class BudgetManager{
  + verifyIfPossible()
}

class StationUpgrader {
  + applyUpgrade()
}

' Relacionamentos
Player --> UpgradeStationUI : usa
UpgradeStationUI --> UpgradeStationController : comunica com

UpgradeStationController --> PlayerRepository : consulta
UpgradeStationController --> StationRepository : consulta
UpgradeStationController --> BuildingRepository : consulta
UpgradeStationController --> StationRepository : valida
UpgradeStationController --> BudgetManager : verifica fundos
UpgradeStationController --> StationUpgrader : executa upgrade






note right of UpgradeStationController::executeUpgrade
  Fluxo principal:
  1. Verifica fundos
  2. Aplica upgrade
  3. Registra na organização
  4. Retorna status
end note



note left of BudgetManager
  Gerencia:
  - Recursos do jogador
  - Custo de upgrades
  - Transações econômicas
end note
@enduml