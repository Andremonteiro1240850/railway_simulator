@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

    class Player {
    name
    email
    password
    }

    class Station {
        buildings
    }

    class Building {
         type
         date
    }

    class BuildingType {
        Telegraph
        Telephone
        SmallHotel
        GrandHotel
        Silo
        LiquidStorage
        Cafe
        PostOffice
    }

    Player --> Station : "select"
    Station "1" --> "*" Building : "add"
    Building --> BuildingType : "have"

@enduml