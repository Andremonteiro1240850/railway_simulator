@startuml
skinparam shadowing false
skinparam linetype polyline
skinparam monochrome true
autonumber

actor Player
activate Player
participant AssignRouteUI
participant AssignRouteController

Player -> AssignRouteUI : request to assign train to route
activate AssignRouteUI
AssignRouteUI -> AssignRouteController : getAvailableTrains()
activate AssignRouteController

ref over AssignRouteController : SD-get-unassigned-trains

AssignRouteController --> AssignRouteUI : availableTrains
deactivate AssignRouteController
AssignRouteUI --> Player : Displays list of available trains
deactivate AssignRouteUI

Player -> AssignRouteUI : selects a train
activate AssignRouteUI
AssignRouteUI -> AssignRouteController : selectTrain(trainId)
activate AssignRouteController

ref over AssignRouteController : SD-create-route-and-assign-train

AssignRouteController --> AssignRouteUI : Route created
deactivate AssignRouteController
AssignRouteUI --> Player : displayRouteSetup
deactivate AssignRouteUI

Player -> AssignRouteUI : confirmRoute
activate AssignRouteUI
AssignRouteUI -> AssignRouteController : confirmRoute()
activate AssignRouteController

ref over AssignRouteController : SD-confirm-train-assignment

AssignRouteController --> AssignRouteUI : operationSuccess()
deactivate AssignRouteController
AssignRouteUI --> Player : display success message
deactivate AssignRouteUI
@enduml
