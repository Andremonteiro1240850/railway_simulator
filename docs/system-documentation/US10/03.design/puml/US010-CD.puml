@startuml
skinparam classAttributeIconSize 0




class AssignRouteUI {
  +requestAssignTrainToRoute()
  +displayAvailableTrains()
  +displayAvailableStations()
  +showCargoTypes()
  +showRouteSummary()
  +confirmRoute()
}

class AssignRouteController {
  +getAvailableTrains()
  +selectTrain(trainId: String)
  +getAvailableStations()
  +getAvailableCargos()
  +selectStation()
  +selectCargo(cargoType: CargoType)
  +confirmRoute()
}

class TrainRepository {
  +getUnassignedTrains(): List<Train>
  +getTrainById(trainId: String): Train
}

class Train {
  +newRoute(): Route
  +assignRoute(route: Route): void
}

class Route {
  +addStop(stationId: String, cargoType: CargoType): void
}

class StationRepository {
  +getAvailableStations(): List<Station>
}

class Station {
  -id: String
  -name: String
}

class CargoRepository {
  +getAvailableCargos(): List<CargoType>
}

class CargoType {
  -name: String
}

class PlayerSessionRepository {
  +getSessionByPlayerId(email: String): PlayerSession
}

class PlayerSession {
  +registerTrainAssignment(train: Train): void
}



AssignRouteUI --> AssignRouteController : requestAssignTrainToRoute()\ndisplayX(), confirmRoute()

AssignRouteController --> TrainRepository : getUnassignedTrains()\ngetTrainById(trainId)
AssignRouteController --> Train : newRoute(), assignRoute()
AssignRouteController --> Route : addStop(stationId, cargoType)
AssignRouteController --> StationRepository : getAvailableStations()
AssignRouteController --> CargoRepository : getAvailableCargos()
AssignRouteController --> PlayerSessionRepository : getSessionByPlayerId()
AssignRouteController --> PlayerSession : registerTrainAssignment(train)

' Relações entre objetos do domínio

Train --> Route : owns
Route --> Station : contains stops
Route --> CargoType : defines cargo at stop

@enduml
