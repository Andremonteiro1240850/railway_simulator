@startuml
autonumber
participant AssignRouteController
activate AssignRouteController
participant LocomotiveRepository
participant Locomotive

AssignRouteController -> LocomotiveRepository : getTrainById(trainId)
activate LocomotiveRepository
LocomotiveRepository --> AssignRouteController : Locomotive
deactivate LocomotiveRepository
activate Locomotive

AssignRouteController -> Locomotive : isAssignable()
Locomotive --> AssignRouteController : true

deactivate Locomotive
deactivate AssignRouteController
@enduml
