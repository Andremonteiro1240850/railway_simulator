@startuml
skinparam shadowing false
skinparam linetype polyline
skinparam monochrome true
autonumber

actor Player
participant AssignRouteUI
participant AssignRouteController
participant TrainRepository
participant StationRepository
participant CargoRepository
participant PlayerSessionRepository
participant PlayerSession
participant Train
participant Route

activate Player

Player -> AssignRouteUI : requestAssignTrainToRoute()
activate AssignRouteUI
AssignRouteUI -> AssignRouteController : getAvailableTrains()
activate AssignRouteController
AssignRouteController -> TrainRepository : getUnassignedTrains()
activate TrainRepository
TrainRepository --> AssignRouteController : List<Train>
deactivate TrainRepository
AssignRouteController --> AssignRouteUI : availableTrains
deactivate AssignRouteController
AssignRouteUI --> Player :Lists available trains and asks to select one
deactivate AssignRouteUI

Player -> AssignRouteUI : Selects a train
activate AssignRouteUI
AssignRouteUI -> AssignRouteController : selectTrain(trainId)
activate AssignRouteController
AssignRouteController -> TrainRepository : getTrainById(trainId)
activate TrainRepository
TrainRepository --> AssignRouteController : Train
deactivate TrainRepository


AssignRouteController -> Route : newRoute()
activate Route
Route--> AssignRouteController : Route
deactivate Route

loop
  AssignRouteController -> StationRepository : getAvailableStations()
  activate StationRepository
  StationRepository --> AssignRouteController : List<Station>
  deactivate StationRepository
  AssignRouteController --> AssignRouteUI : show Avialable stations
  deactivate AssignRouteController
  AssignRouteUI --> Player : Lists possible stations and requests selection
  deactivate AssignRouteUI
  Player -> AssignRouteUI : Selects one station
  activate AssignRouteUI
  AssignRouteUI -> AssignRouteController : selectStation()
  activate AssignRouteController
  AssignRouteController -> CargoRepository : getAvailableCargos()
  activate CargoRepository
  CargoRepository --> AssignRouteController : List<CargoType>
  deactivate CargoRepository
  AssignRouteController --> AssignRouteUI : showCargoTypes
  deactivate AssignRouteController
  AssignRouteUI --> Player : Lists possible cargo types to pick up at station
deactivate AssignRouteUI
  Player -> AssignRouteUI : Selects cargo to pick up
  activate AssignRouteUI
  AssignRouteUI -> AssignRouteController : selectCargo(cargoType)
  activate AssignRouteController
  AssignRouteController -> Route : addStop(stationId, cargoType)
  activate Route
  Route--> AssignRouteController: stop added
  deactivate Route
end

AssignRouteController --> AssignRouteUI : showRouteSummary()
deactivate AssignRouteController
AssignRouteUI --> Player : displayRouteAndCargoSummary, requests confirmation
deactivate AssignRouteUI
Player -> AssignRouteUI : confirms data
activate AssignRouteUI
AssignRouteUI -> AssignRouteController : confirmRoute()
activate AssignRouteController
AssignRouteController -> PlayerSessionRepository : getSessionPlayer()
activate PlayerSessionRepository
PlayerSessionRepository --> AssignRouteController : PlayerSession
deactivate PlayerSessionRepository


AssignRouteController -> Train : assignRoute(Route)
activate Train
Train-->AssignRouteController: Route Assigned
deactivate Train

deactivate Route
AssignRouteController -> PlayerSession : registerTrainAssignment(train)
activate PlayerSession
PlayerSession--> AssignRouteController: Train assigment
deactivate PlayerSession
AssignRouteController --> AssignRouteUI : operationSuccess()
deactivate AssignRouteController
AssignRouteUI --> Player : displaySuccessMessage
deactivate AssignRouteUI

@enduml
