@startuml
autonumber
participant AssignRouteController
activate AssignRouteController
participant AuthenticationRepository

participant Locomotive
participant Route
participant LocomotiveRepository
participant StationRepository

AssignRouteController -> AuthenticationRepository : getSessionByPlayerId()
activate AuthenticationRepository
AuthenticationRepository --> AssignRouteController : PlayerSession
deactivate AuthenticationRepository
AssignRouteController --> LocomotiveRepository: getLocomotive()
activate LocomotiveRepository
LocomotiveRepository--> AssignRouteController: availableLocomotives
deactivate LocomotiveRepository
AssignRouteController --> StationRepository: getStations()
activate StationRepository
StationRepository --> AssignRouteController: listStations
deactivate StationRepository
AssignRouteController -> Route : assignRoute(stations)
activate Route
Route --> AssignRouteController: routeCreated
deactivate Locomotive



deactivate AssignRouteController
@enduml
