@startuml
autonumber
participant AssignRouteController
activate AssignRouteController
participant AuthenticationRepository
participant PlayerSession
participant LocomotiveRepository


AssignRouteController -> AuthenticationRepository : getSessionByPlayerId()
activate AuthenticationRepository
AuthenticationRepository --> AssignRouteController : PlayerSession
deactivate AuthenticationRepository


AssignRouteController -> LocomotiveRepository : getAllTrains()
activate LocomotiveRepository
LocomotiveRepository --> AssignRouteController : List<Train>
deactivate LocomotiveRepository


AssignRouteController -> LocomotiveRepository : filterUnassignedTrains(List<Train>)
activate LocomotiveRepository
LocomotiveRepository --> AssignRouteController : List<Train>

deactivate LocomotiveRepository
deactivate AssignRouteController
@enduml
