@startuml
autonumber
participant BuyLocomotiveController

participant ScenarioRepository
participant LocomotiveRepository

-> BuyLocomotiveController : getAvailableLocomotives()
activate BuyLocomotiveController
BuyLocomotiveController -> ScenarioRepository : getScenario()
activate ScenarioRepository
ScenarioRepository --> BuyLocomotiveController : Scenario
deactivate ScenarioRepository

BuyLocomotiveController -> LocomotiveRepository : getCurrentScenarioLocomotives()
activate LocomotiveRepository
LocomotiveRepository --> BuyLocomotiveController : CurrentScenarioLocomotives
deactivate LocomotiveRepository

<--BuyLocomotiveController  : AvailableLocomotives
deactivate BuyLocomotiveController

@enduml
