@startuml
autonumber
participant BuyLocomotiveController

participant LocomotiveRepository
participant Locomotive

-> BuyLocomotiveController : getLocomotiveDetails()
activate BuyLocomotiveController
BuyLocomotiveController -> LocomotiveRepository : getLocomotive()
activate LocomotiveRepository
LocomotiveRepository --> BuyLocomotiveController : Locomotive
deactivate LocomotiveRepository

BuyLocomotiveController -> Locomotive : getType()
activate Locomotive
Locomotive --> BuyLocomotiveController : type
deactivate Locomotive

BuyLocomotiveController -> Locomotive : getPrice()
activate Locomotive
Locomotive --> BuyLocomotiveController : price
deactivate Locomotive


<--BuyLocomotiveController  : LocomotiveDetails
deactivate BuyLocomotiveController
@enduml
