@startuml
skinparam classAttributeIconSize 0

' ===== CLASSES DO CASO DE USO PRINCIPAL =====

class BuyLocomotiveUI {
  +requestToBuyLocomotive()
  +displayAvailableLocomotives(locomotives)
  +displayLocomotiveDetails(locomotive)
  +confirmPurchase(locomotive)
}

class BuyLocomotiveController {
  +getAvailableLocomotives()
  +getLocomotiveDetails()
  +confirmPurchase(locomotive)
}

class Repositories {
  +getInstance()
  +getScenarioRepository()
  +getLocomotiveRepository()
  +getPlayerSessionRepository()
}

class ScenarioRepository {
  +getScenario(): Scenario
}

class LocomotiveRepository {
  +getCurrentScenarioLocomotives(): List<Locomotive>
  +getLocomotive(): Locomotive
}

class PlayerSessionRepository {
  +getSessionByPlayerId(email): PlayerSession
}

class Locomotive {
  -type: String
  -price: double
  +getType(): String
  +getPrice(): double
}

class Scenario {
  -currentDate: LocalDate
  +getCurrentDate(): LocalDate
}

class PlayerSession {
  -budget: double
  -purchases: List<LocomotivePurchase>
  +canAfford(price): boolean
  +deductBudget(price)
  +addPurchase(lp: LocomotivePurchase)
}

class LocomotivePurchase {
  +create(purchaseId, baseId, type, price, date)
}

class ApplicationSession {
  +getInstance()
  +getCurrentSession(): UserSession
}

class UserSession {
  +getUserEmail(): String
}

' ===== RELAÇÕES ENTRE CLASSES =====

BuyLocomotiveUI --> BuyLocomotiveController
BuyLocomotiveController --> Repositories
Repositories --> ScenarioRepository
Repositories --> LocomotiveRepository
Repositories --> PlayerSessionRepository
BuyLocomotiveController --> ScenarioRepository : getScenario()
BuyLocomotiveController --> LocomotiveRepository : getCurrentScenarioLocomotives()
BuyLocomotiveController --> LocomotiveRepository : getLocomotive()
BuyLocomotiveController --> PlayerSessionRepository : getSessionByPlayerId()
BuyLocomotiveController --> Scenario : getCurrentDate()
BuyLocomotiveController --> PlayerSession : canAfford(), deductBudget(), addPurchase()
BuyLocomotiveController --> Locomotive : getType(), getPrice()
BuyLocomotiveController --> LocomotivePurchase : create()
ApplicationSession --> UserSession
ApplicationSession --> ApplicationSession : getInstance()
ApplicationSession --> ApplicationSession : getCurrentSession()
UserSession --> BuyLocomotiveController : getUserEmail()

@enduml
