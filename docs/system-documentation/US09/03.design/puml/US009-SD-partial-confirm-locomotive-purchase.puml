@startuml
autonumber
participant BuyLocomotiveController
activate BuyLocomotiveController
participant PlayerSessionRepository
participant PlayerSession
participant Locomotive
participant ScenarioRepository
participant Scenario
participant LocomotivePurchase

-> BuyLocomotiveController : confirmPurchase (locomotive)
BuyLocomotiveController -> PlayerSessionRepository : getSessionByPlayerId(playerId)
activate PlayerSessionRepository
PlayerSessionRepository --> BuyLocomotiveController : PlayerSession
deactivate PlayerSessionRepository


BuyLocomotiveController -> Locomotive : getPrice()
activate Locomotive
Locomotive --> BuyLocomotiveController : price
deactivate Locomotive

BuyLocomotiveController -> PlayerSession : deductBudget(price)
activate PlayerSession
PlayerSession--> BuyLocomotiveController: Budget atualized
deactivate PlayerSession

BuyLocomotiveController -> ScenarioRepository : getScenario()
activate ScenarioRepository
ScenarioRepository --> BuyLocomotiveController : Scenario
deactivate ScenarioRepository


BuyLocomotiveController -> Scenario : getCurrentDate()
activate Scenario
Scenario --> BuyLocomotiveController : currentDate
deactivate Scenario

BuyLocomotiveController -> LocomotivePurchase : create(purchaseId, baseId, type, price, date)
activate LocomotivePurchase
LocomotivePurchase--> BuyLocomotiveController: created

deactivate LocomotivePurchase


BuyLocomotiveController -> PlayerSession : addPurchase(LocomotivePurchase)
activate PlayerSession
PlayerSession--> BuyLocomotiveController: Purchase added
deactivate PlayerSession



<--BuyLocomotiveController : purchase confirmed
deactivate BuyLocomotiveController
@enduml
