@startuml

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

class Player {
  name
  email
}

class Scenario {
  name
  currentDate
}

class Purchase {
  timestamp
  status
  price
}

class Locomotive {
  type
  price
  speed
  name
  maintenanceCost
  yearStart
  acceleration
}




' Relações com multiplicidade
Player "1" -- "*" Scenario : plays in
Player "1" -- "*" Purchase : makes
Scenario "1" -- "*" Locomotive : provides
Purchase "1" -- "1" Locomotive : involves



@enduml
