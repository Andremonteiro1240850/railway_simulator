@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

    class Player {
    name
    email
    password
    }

    class Station {
        name
        type
    }

    class StationType {
        Depot
        Station
        Terminal
    }

    class Position {
        x
        y
    }

    Player --> Station : "make"
    Station "1" --> "1" StationType : "have"
    Station "1" --> "1" Position : "have"

@enduml