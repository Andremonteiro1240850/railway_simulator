@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":CreateStationController" as CTRL
participant "TypeStationRepository" as GEO


autonumber 6.5
-> CTRL : getCentre()
activate CTRL

        CTRL -> GEO : calculateCenter(stationType, location)
        activate GEO
            GEO --> CTRL : centerPoint
        deactivate GEO


    autonumber 6.6
    <-- CTRL : centerPoint
deactivate CTRL
@enduml