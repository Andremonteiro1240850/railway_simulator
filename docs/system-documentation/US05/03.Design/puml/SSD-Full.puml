@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

hide footbox
actor "Player" as ORG_EMPLOYEE

participant ":CreateStationUI" as UI
participant ":CreateStationController" as CTRL
participant "StationRepository" as REPOS
participant "CreateMapRepository" as MAP
participant "LocationValidator" as VALID
participant "Station" as NAMING
participant "City" as CITY
participant "PositionValidator" as VALID
participant "Map" as RAIL
participant "StationTypeRepository" as REPOT

activate ORG_EMPLOYEE

    ORG_EMPLOYEE -> UI : asks to build a staion
    autonumber 1

    activate UI
        UI --> CTRL** : create()
        autonumber 2
        UI -> CTRL : getStationTypes()
        autonumber 3
        autonumber 3.1
        activate CTRL

                    CTRL -> REPOT : getStationTypeList()
                    activate REPOT
                        REPOT --> CTRL: stationTypesList
                    deactivate REPOT

            CTRL --> UI : stationTypesList
            autonumber 4
        deactivate CTRL
        UI --> ORG_EMPLOYEE : verify if is allowed to build a station and\n show station types
        autonumber 5
    deactivate UI

    ORG_EMPLOYEE -> UI : selects station type
    activate UI
    UI -> ORG_EMPLOYEE : Ask for location
    deactivate UI
    ORG_EMPLOYEE -> UI : Give location
    autonumber 6
    activate UI
        UI -> CTRL : getLocation()
        autonumber 6.1

        activate CTRL

                CTRL -> MAP : requestCoordinates()
                activate MAP
                    MAP --> CTRL : giveCoordinates


                CTRL -> MAP : validateXY()

                    MAP --> CTRL : isValid
                deactivate MAP

            CTRL --> UI : location
            autonumber 6.2
        deactivate CTRL

        UI -> CTRL : getName()
        autonumber 6.3

        activate CTRL

                CTRL -> CITY : getNearestCity(location)
                activate CITY
                    CITY --> CTRL : cityName
                deactivate CITY

                CTRL -> NAMING : generateName(cityName, stationType)
                activate NAMING
                    NAMING --> CTRL : suggestedName
                deactivate NAMING
                CTRL -> UI : name

            autonumber 6.4

        deactivate CTRL

        UI -> CTRL : getCentre()
        autonumber 6.5

        activate CTRL

                CTRL -> REPOT : calculateCenterOptions()
                activate REPOT
                    REPOT --> CTRL : centerOptions
                deactivate REPOT

                CTRL -> UI : centreOptions

            autonumber 6.6

        deactivate CTRL

        UI --> ORG_EMPLOYEE : requests information (name, (centre if Staion)) and sugest name
        autonumber 7
    deactivate UI

    ORG_EMPLOYEE -> UI : types requested information

    autonumber 8
    activate UI
        UI --> ORG_EMPLOYEE : shows all data and name suggested, and requests confirmation
        autonumber 9
    deactivate UI

    ORG_EMPLOYEE -> UI : confirms data
    autonumber 10
    activate UI
        UI -> CTRL : createStation(Type, location, name, centre)
        autonumber 11
        activate CTRL

            autonumber 12

            activate CTRL

                    CTRL -> RAIL : verifyIfPossible(stationType)
                    activate RAIL
                        RAIL --> CTRL : isPossible
                    deactivate RAIL

                    CTRL -> RAIL : buildStation()
                    activate RAIL
                        RAIL --> CTRL : stationBuilt
                        deactivate RAIL
                        CTRL -> REPOS : saveStation()
                        activate REPOS
                        REPOS --> CTRL: stationSaved
                        deactivate REPOS
                    deactivate RAIL

                autonumber 18
                CTRL -> UI : stationCreated

            deactivate CTRL
        UI --> ORG_EMPLOYEE: displays operation success and build
        autonumber 19
    deactivate UI

deactivate ORG_EMPLOYEE
@enduml