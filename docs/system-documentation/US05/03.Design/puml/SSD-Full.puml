@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

hide footbox
actor "Player" as ORG_EMPLOYEE

participant ":BuildStationUI" as UI
participant ":BuildStationController" as CTRL
participant "repositories\n:Repositories" as REPOS_SINGLETON
participant "scenario\n:Scenario" as SCENARIO_OBJ #LightBlue
participant "map\n:Map" as MAP_OBJ #LightBlue
participant "stationRepository\n:StationRepository" as STATION_REPO

' DTOs adicionados
participant "ScenarioDTO" as SCENARIO_DTO #LightGreen
participant "StationDTO" as STATION_DTO #LightGreen

activate ORG_EMPLOYEE

ORG_EMPLOYEE -> UI : asks to build a station
activate UI
    UI --> CTRL : create()
    activate CTRL
    CTRL --> UI : initializationComplete
    deactivate CTRL

    UI -> REPOS_SINGLETON : getInstance()
    activate REPOS_SINGLETON
    REPOS_SINGLETON --> UI : repositories

    UI -> REPOS_SINGLETON : getScenarioRepository()
    REPOS_SINGLETON --> UI : scenarioRepo
    deactivate REPOS_SINGLETON

    UI -> scenarioRepo : getAll()
    activate scenarioRepo
    scenarioRepo --> UI : List<Scenario>
    deactivate scenarioRepo

    ' Conversão para DTO
    UI -> SCENARIO_DTO : convert(List<Scenario>)
    activate SCENARIO_DTO
    SCENARIO_DTO --> UI : List<ScenarioDTO>
    deactivate SCENARIO_DTO

    UI --> ORG_EMPLOYEE : show available scenarios
deactivate UI

ORG_EMPLOYEE -> UI : selects scenario
activate UI
    UI -> CTRL : setScenario(dto : ScenarioDTO)
    activate CTRL
    CTRL --> UI : success
    deactivate CTRL

    UI --> ORG_EMPLOYEE : requests X coordinate
deactivate UI

ORG_EMPLOYEE -> UI : types X coordinate
activate UI
    UI --> ORG_EMPLOYEE : requests Y coordinate
deactivate UI

ORG_EMPLOYEE -> UI : types Y coordinate
activate UI
    UI -> CTRL : suggestStationName(x, y, type:StationTypes)
    activate CTRL
        CTRL -> SCENARIO_OBJ : getMap()
        activate SCENARIO_OBJ
        SCENARIO_OBJ --> CTRL : Map
        deactivate SCENARIO_OBJ

        CTRL -> MAP_OBJ : getCities()
        activate MAP_OBJ
        MAP_OBJ --> CTRL : List<City>
        deactivate MAP_OBJ

        CTRL --> UI : suggestedName
    deactivate CTRL

    UI --> ORG_EMPLOYEE : shows suggested name and requests confirmation
deactivate UI

ORG_EMPLOYEE -> UI : selects station type and region, confirms data
activate UI
    ' Substituir vários parâmetros por DTO
    UI -> CTRL : createStation(dto : StationDTO)
    activate CTRL

        CTRL -> SCENARIO_OBJ : getMap()
        activate SCENARIO_OBJ
        SCENARIO_OBJ --> CTRL : Map
        deactivate SCENARIO_OBJ

        CTRL -> MAP_OBJ : getWidth()
        activate MAP_OBJ
        MAP_OBJ --> CTRL : width
        CTRL -> MAP_OBJ : getHeight()
        MAP_OBJ --> CTRL : height
        deactivate MAP_OBJ

        CTRL -> REPOS_SINGLETON : getInstance()
        activate REPOS_SINGLETON
        REPOS_SINGLETON --> CTRL : repositories
        deactivate REPOS_SINGLETON

        CTRL -> REPOS_SINGLETON : getStationRepository()
        activate REPOS_SINGLETON
        REPOS_SINGLETON --> CTRL : stationRepository
        deactivate REPOS_SINGLETON

        CTRL -> STATION_REPO : getAll()
        activate STATION_REPO
        STATION_REPO --> CTRL : List<Station>
        deactivate STATION_REPO

        CTRL -> SCENARIO_OBJ : getBudget()
        activate SCENARIO_OBJ
        SCENARIO_OBJ --> CTRL : budget
        deactivate SCENARIO_OBJ

        create "newStation:Station" as NEW_STATION_OBJ
        CTRL -> NEW_STATION_OBJ : <<create>>(from DTO)
       activate NEW_STATION_OBJ
        NEW_STATION_OBJ --> CTRL : Station
        deactivate NEW_STATION_OBJ

        CTRL -> SCENARIO_OBJ : addStationPurchased(newStation)
        activate SCENARIO_OBJ
        SCENARIO_OBJ --> CTRL : success
        deactivate SCENARIO_OBJ

        CTRL -> STATION_REPO : add(newStation)
        activate STATION_REPO
        STATION_REPO --> CTRL : Optional<Station>
        deactivate STATION_REPO

        alt if added.isPresent()
            CTRL -> SCENARIO_OBJ : setBudget(budget - cost)
            activate SCENARIO_OBJ
            SCENARIO_OBJ --> CTRL : success
            deactivate SCENARIO_OBJ
            CTRL --> UI : true (stationCreated)
        else
            CTRL --> UI : false (stationNotCreated)
        end
    deactivate CTRL
    UI --> ORG_EMPLOYEE : displays operation success/failure
deactivate UI

deactivate ORG_EMPLOYEE
@enduml
