@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":CreateStationController" as CTRL
participant "map" as MAP


autonumber 6.1
-> CTRL : getLocation()
activate CTRL

        CTRL -> MAP : requestCoordinates()
        activate MAP
            MAP --> CTRL : giveCoordinates


        CTRL -> MAP : validateXY()

            MAP --> CTRL : isValid
        deactivate MAP

    autonumber 6.2
    <-- CTRL : location
deactivate CTRL
@enduml