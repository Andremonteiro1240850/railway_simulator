@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

'hide footbox

participant ":CreateStationController" as CTRL
participant "StationTypeRepositories" as REPOS

autonumber 3

 -> CTRL : getStationTypes()
autonumber 3.1
activate CTRL
    group Get Station Type List

            CTRL -> REPOS : getStationTypeList()
            activate REPOS
                REPOS --> CTRL: stationTypeList
                deactivate REPOS


    <-- CTRL  : stationTypeList
deactivate CTRL

@enduml