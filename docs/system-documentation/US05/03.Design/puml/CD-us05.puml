@startuml

skinparam monochrome false
skinparam shadowing false
hide empty members

class Player {
}

class BuildStationUI {
  + asksToBuildStation()
  + showStationTypes()
  + askForLocation()
  + showDataAndRequestConfirmation()
  + displayOperationSuccess()
}

class CreateStationController {
  + getStationTypes()
  + getLocation()
  + getName()
  + getCentre()
  + createStation()
}

class StationRepository {
  + getStationTypeList()
  + calculateCenterOptions()
  + saveStation()
}

class CreateMapRepository {
  + requestCoordinates()
}


class Station {
  + generateName()
}

class City {
  + getNearestCity()
}



class Map {
  + buildStation()
}


class StationTypeRepository {
  + getStationTypeList()
}

' Relacionamentos
Player --> CreateStationUI:"use"
CreateStationUI --> CreateStationController:"create"

Station --> StationRepository: "save station on"
CreateStationController --> CreateMapRepository:"check and validate"
CreateStationController --> Station: "create"
CreateStationController --> City: "get"
CreateStationController --> Map: "get"
CreateStationController --> StationTypeRepository: "get"

@enduml