@startuml

skinparam monochrome false
skinparam shadowing false
hide empty members

class Player {
}

class BuildStationUI {
  + asksToBuildStation()
  + showStationTypes()
  + askForLocation()
  + showDataAndRequestConfirmation()
  + displayOperationSuccess()
}

class CreateStationController {
  + getStationTypes()
  + getLocation()
  + getName()
  + getCentre()
  + createStation()
}

class StationRepository {
  + getStationTypeList()
  + calculateCenterOptions()
  + saveStation()
}

class MapRepository {
  + requestCoordinates()
}

class LocationValidator {
  + validateXY()
}

class StationNaming {
  + generateName()
}

class City {
  + getNearestCity()
}

class PositionValidator {
  + validateXY()
}

class Map {
  + buildStation()
}

class BudgetManager {
  + verifyIfPossible()
}

class StationTypeRepository {
  + getStationTypeList()
}

' Relacionamentos
Player --> CreateStationUI
CreateStationUI --> CreateStationController

CreateStationController --> StationRepository
CreateStationController --> MapRepository
CreateStationController --> LocationValidator
CreateStationController --> StationNaming
CreateStationController --> City
CreateStationController --> PositionValidator
CreateStationController --> Map
CreateStationController --> BudgetManager
CreateStationController --> StationTypeRepository

@enduml