@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":CreateStationController" as CTRL
participant "map" as RAIL


autonumber 12
-> CTRL : createStation()
activate CTRL

        CTRL -> RAIL : verifyIfPossible(stationType)
        activate RAIL
            RAIL --> CTRL : isPossible


        CTRL -> RAIL : buildStation()

            RAIL --> CTRL : stationBuilt
        deactivate RAIL

    autonumber 18
    <-- CTRL : stationCreated
deactivate CTRL
@enduml