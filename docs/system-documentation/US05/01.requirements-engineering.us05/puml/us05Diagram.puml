@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Employee
participant ":System" as System

activate Employee

    Employee -> System : Ask to build a station
    activate System

        System --> Employee : show avaiable scenarios
    deactivate System

    Employee -> System : select scenario
    activate System

        System --> Employee :  ask for cordinate x
    deactivate System

    Employee -> System : Give cordinate
    activate System

        System --> Employee : ask for cordinate y
    deactivate System

    Employee -> System : Give cordinate
    activate System

        System --> Employee : show sugested name and request confirmation
    deactivate System
    Employee -> System : select station type and region (if station) and confirms name
    activate System
    System -> Employee : display operation sucess and build station

@enduml