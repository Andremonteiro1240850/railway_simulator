@startuml
'https://plantuml.com/class-diagram

skinparam monochrome false
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

' ==== Core Classes ====
class CreateMapUI {
  - controller: CreateMapController
  + startCreation()
  + requestMapName()
  + requestMapSize()
  + showSuccess(message: String)
  + showError(error: String)
}

class CreateMapController {
  - validator: MapValidator
  - factory: MapFactory
  - repo: CreateMapRepository
  + validateName(name: String): boolean
  + validateSize(width: int, height: int): boolean
  + createMap(name: String, width: int, height: int): boolean
}

class MapValidator {
  + isValidName(name: String): boolean {static}
  + isValidSize(width: int, height: int): boolean {static}
}


class Map {
  - name: String
  - width: int
  - height: int
  + Map(name: String, width: int, height: int)
  + getName(): String
  + getWidth(): int
  + getHeight(): int
}

class CreateMapRepository {
  + save(map: Map): boolean
  + rollback()
}

' ==== Dependencies ====
CreateMapUI --> CreateMapController : delegates
CreateMapController --> MapValidator : uses
MapValidator --> Map : validates
CreateMapController --> Map : creates >
CreateMapController --> CreateMapRepository : persists >
Map --> CreateMapRepository : saved in

@enduml