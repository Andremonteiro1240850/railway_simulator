@startuml
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor Editor

activate Editor
Editor -> CreateMapUI : Create Map Request
activate CreateMapUI

CreateMapUI --> Editor : Request Map Name
Editor -> CreateMapUI : Enter Map Name
CreateMapUI -> MapValidator : validateName(name)
activate MapValidator

alt name is valid (AC02: no special chars/digits)
  MapValidator --> CreateMapUI : nameValid
  CreateMapUI --> Editor : Request Map Dimensions
  Editor -> CreateMapUI : Enter Dimensions (width, height)
  CreateMapUI -> MapValidator : validateDimensions(width, height)

  alt dimensions are valid (AC01: positive integers)
    MapValidator --> CreateMapUI : dimensionsValid
    CreateMapUI -> MapController : createMap(name, width, height)
    activate MapController
    MapController -> Map : new(name, width, height)
    activate Map
    Map --> MapController : mapInstance
    deactivate Map

    MapController -> MapRepository : save(mapInstance)
    activate MapRepository
    MapRepository --> MapController : saveConfirmed
    deactivate MapRepository

    MapController --> CreateMapUI : mapCreated
    deactivate MapController
    CreateMapUI -> Editor : Show Success ("Map created")
  else dimensions invalid
    MapValidator --> CreateMapUI : invalidDimensions
    CreateMapUI -> Editor : Show Error ("Dimensions must be positive integers")
  end
else name invalid
  MapValidator --> CreateMapUI : invalidName
  CreateMapUI -> Editor : Show Error ("Name cannot contain special characters/digits")
end

deactivate MapValidator
deactivate CreateMapUI
deactivate Editor
@enduml