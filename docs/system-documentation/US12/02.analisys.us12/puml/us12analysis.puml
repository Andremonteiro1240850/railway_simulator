@startuml

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

class ProductOwner {
  - name : String
}

class Simulator {
  - state : String
}

class Station {
  - name : String
  - location : Coordinate
}

class City {
  - name : String
  - passengers : int
  - mail : int
}

class Industry {
  - name : String
  - type : IndustryType
}

class Cargo {
  - type : String
  - quantity : int
}

class Coordinate {
  - x : int
  - y : int
}

enum IndustryType {
  Primary
  Transforming
  Mixed
}

ProductOwner "1" -- "1" Simulator : configures
Simulator "1" -- "*" Station : manages
Station "1" -- "*" Cargo : generates
Station "1" -- "0..1" City : serves
Station "1" -- "*" Industry : serves
City "1" -- "*" Cargo : consumes
Industry "1" -- "*" Cargo : produces
Station "1" -- "1" Coordinate : is located at

@enduml
