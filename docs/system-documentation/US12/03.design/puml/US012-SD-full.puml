@startuml
skinparam shadowing false
skinparam linetype polyline
skinparam monochrome true
autonumber

actor ProductOwner
activate ProductOwner
participant SimulationUI
participant SimulationController
participant ScenarioRepository
participant StationRepository
participant Station
participant CargoGenerator
participant SimulationScheduler

' Select scenario and map
ProductOwner -> SimulationUI : select scenario and map
activate SimulationUI
SimulationUI -> ScenarioRepository : loadScenario(mapId)
activate ScenarioRepository
ScenarioRepository --> SimulationUI : scenario loaded successfully
deactivate ScenarioRepository
SimulationUI --> ProductOwner : scenario loaded successfully
deactivate SimulationUI

' Start simulator
ProductOwner -> SimulationUI : start simulator
activate SimulationUI
SimulationUI -> SimulationController : initSimulator()
activate SimulationController
SimulationController --> SimulationUI : simulator ready
deactivate SimulationController
SimulationUI --> ProductOwner : simulator ready
deactivate SimulationUI

' Start simulation
ProductOwner -> SimulationUI : start simulation
activate SimulationUI
SimulationUI -> SimulationController : startSimulation()
activate SimulationController

SimulationController -> StationRepository : getAllStations()
activate StationRepository
StationRepository --> SimulationController : List<Station>
deactivate StationRepository

SimulationController -> Station : isValidForCargoGeneration()
activate Station
Station --> SimulationController : true/false
deactivate Station

SimulationController -> CargoGenerator : generateCargo(Station, Scenario)
activate CargoGenerator
CargoGenerator --> SimulationController : Cargo[]
deactivate CargoGenerator

SimulationController -> SimulationScheduler : scheduleGeneration(Station, periodicity)
activate SimulationScheduler
SimulationScheduler --> SimulationController : scheduled
deactivate SimulationScheduler

SimulationController -> Station : storeCargo(Cargo[])
activate Station
Station --> SimulationController : stored successfully
deactivate Station
SimulationController-->SimulationUI : start simulation
deactivate SimulationController
SimulationUI --> ProductOwner : simulation started
deactivate SimulationUI


ProductOwner -> SimulationUI : pause simulation
activate SimulationUI
SimulationUI -> SimulationController : pause()
activate SimulationController
SimulationController --> SimulationUI : simulation paused successfully
deactivate SimulationController
SimulationUI --> ProductOwner : simulation paused successfully
deactivate SimulationUI

@enduml
