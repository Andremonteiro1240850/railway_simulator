@startuml
skinparam shadowing false
skinparam linetype polyline
skinparam monochrome true
autonumber

actor ProductOwner
activate ProductOwner
participant SimulationUI
participant SimulationController

ProductOwner -> SimulationUI : pause simulation
activate SimulationUI
SimulationUI -> SimulationController : pause()
activate SimulationController
SimulationController --> SimulationUI : simulation paused successfully
deactivate SimulationController
SimulationUI --> ProductOwner : simulation paused successfully
deactivate SimulationUI
@enduml
