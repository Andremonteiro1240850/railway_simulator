@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

hide footbox
actor "Editor" as ORG_EMPLOYEE

participant ":CreateScenarioUI" as UI
participant ":CreateScenarioController" as CTRL

participant "map\n:CreateMapRepository" as MAP
participant "PortBehaviour" as PORT
participant ":LocomotiveType" as TS
participant "industry\n:IndustryRepository" as IND
participant "scenario\n:Scenario" as SCEN
participant ":HistoricalEvent" as EVENT
participant "scenarioRepo\n:ScenarioRepository" as SCEN_REPO

activate ORG_EMPLOYEE

    ORG_EMPLOYEE -> UI : asks to create a new scenario
    autonumber 1

    activate UI
        UI --> CTRL** : create()
        autonumber 2
        UI -> CTRL : getAvailableMaps()
        autonumber 3

        activate CTRL
            CTRL --> MAP**: getAllMaps()
            autonumber 4
            activate MAP
                MAP --> CTRL: mapsList
                autonumber 5
            deactivate MAP
            CTRL --> UI : availableMaps
            autonumber 6
        deactivate CTRL

        UI --> ORG_EMPLOYEE : Verify permission and ask to select a map
        autonumber 7
    deactivate UI

    ORG_EMPLOYEE -> UI : selects a map
    autonumber 8
    activate UI
        UI -> CTRL : getAvailablePortBehaviors()
        autonumber 9

        activate CTRL
            CTRL --> PORT**: getBehaviorOptions()
            autonumber 10
            activate PORT
                PORT --> CTRL: behaviorOptions
                autonumber 11
            deactivate PORT
            CTRL --> UI : portBehaviorOptions
            autonumber 12
        deactivate CTRL

        UI -> CTRL : getAvailableLocomotionTypes()
        autonumber 13

        activate CTRL
            CTRL -> TS: requestLocomotionTypes()
            autonumber 14
            activate TS
                TS --> CTRL: availableTypes
                autonumber 15
            deactivate TS
            CTRL --> UI : locomotionTypes
            autonumber 16
        deactivate CTRL

        UI -> CTRL : getIndustryGenerationFactors()
        autonumber 17

        activate CTRL
            CTRL --> IND**: getGenerationFrequency()
            autonumber 18
            activate IND
                IND --> CTRL: generateFrequency
                autonumber 19
            deactivate IND
            CTRL --> UI : industryFactors
            autonumber 20

        UI -> CTRL : loadApplicableHistoricalEvents(startYear)
        autonumber 12

            CTRL -> EVENT : filter enum Eventos\nwhere year ∈ [startYear, endYear]
            activate EVENT
            autonumber 13
            EVENT --> CTRL : list of applicable events
            deactivate EVENT
            autonumber 14


        CTRL --> UI : historicalEvents
        deactivate CTRL

        UI --> ORG_EMPLOYEE : requests scenario details (port behavior, cargoes transform and import or export,\n locomotion types, frequency of generating industries )
        autonumber 21
    deactivate UI

    ORG_EMPLOYEE -> UI : provide requested data
    autonumber 22
    activate UI
        UI --> ORG_EMPLOYEE : shows all data and requests confirmation
        autonumber 23
    deactivate UI

    ORG_EMPLOYEE -> UI : confirms data
    autonumber 24
    activate UI
        UI -> CTRL : createScenario()
        autonumber 25

        activate CTRL
            CTRL --> SCEN**: create(map, params)
            autonumber 26
            activate SCEN
                SCEN -> SCEN: setPortBehavior()
                autonumber 27
                SCEN -> SCEN: setLocomotionTypes()
                autonumber 28
                SCEN -> SCEN: configureIndustries()
                autonumber 29
                SCEN --> CTRL: newScenario
                autonumber 30
            deactivate SCEN
             CTRL -> SCEN_REPO : add(newScenario)
                            autonumber 18
                            activate SCEN_REPO
                                SCEN_REPO --> CTRL : optionalScenario
                                autonumber 19
                            deactivate SCEN_REPO
            CTRL --> UI: createScenario

            autonumber 31
        deactivate CTRL
        UI --> ORG_EMPLOYEE: displays operation success
        autonumber 32
    deactivate UI

deactivate ORG_EMPLOYEE
@enduml