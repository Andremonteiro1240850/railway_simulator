@startuml
skinparam monochrome false
skinparam packageStyle rectangle
skinparam shadowing false

class Editor {
}

class CreateScenarioUI {
  + askToCreateNewScenario()
  + showAvailableMaps(mapsList)
  + requestScenarioDetails()
  + showConfirmation(data)
  + displaySuccess()
}

class CreateScenarioController {
  + getAvailableMaps()
  + getAvailablePortBehaviors()
  + getAvailableLocomotionTypes()
  + getIndustryGenerationFactors()
  + createScenario(params)
}


class CreateMapRepository {
  + getAllMaps()
}

class PortBehavior {
  + getBehaviorOptions()
}

class Locomotive {
  + requestLocomotionTypes()
}

class IndustryRepository {
  + getGenerationFrequency()
}

class ScenarioManager {
  + create(map, params)
  + setPortBehavior()
  + setLocomotionTypes()
  + configureIndustries()
}

' Relacionamentos
Editor --> CreateScenarioUI : use
CreateScenarioUI --> CreateScenarioController : comunicate
CreateScenarioController --> CreateMapRepository : goes
CreateScenarioController --> PortBehavior : goes
CreateScenarioController --> Locomotive : goes
CreateScenarioController --> IndustryRepository : goes
CreateScenarioController --> ScenarioManager : create
ScenarioManager --> Locomotive : configure




@enduml