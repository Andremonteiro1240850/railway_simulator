@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":CreateScenarioController" as CTRL
participant "Locomotive" as TS

autonumber
-> CTRL: getAvailableLocomotionTypes()
activate CTRL
    CTRL -> TS: requestLocomotionTypes()
    activate TS
        TS --> CTRL: availableTypes
    deactivate TS
<-- CTRL: locomotionTypes
deactivate CTRL
@enduml