@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

    class Editor {
        ID
    }

    class Scenario {
        timeRestrictions
        techRestrictions
        portBehavior
    }

    class PortBehavior {
        imports
        exports
    }

    class LocomotionType {
        Steam
        Diesel
        Electric
    }

    Editor --> Scenario : "makes"
    Scenario "1" --> "1" PortBehavior : "define"
    Scenario "1" --> "1" LocomotionType : "need"
@enduml
